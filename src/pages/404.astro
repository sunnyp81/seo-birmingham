---
import Base from '../layouts/Base.astro';
---

<Base title="Page Not Found | SEO Birmingham" description="This page doesn't exist. Head back to SEO Birmingham for search optimisation services across Birmingham and the West Midlands." noindex={true}>
  <section class="relative min-h-screen bg-brand flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-20"></div>
    <div class="relative z-10 text-center px-6 fade-up">
      <p class="text-[#F59E0B] font-[family-name:var(--font-heading)] text-[10rem] sm:text-[14rem] font-black leading-none tracking-tighter select-none">404</p>
      <p class="text-[#FAFAFA] font-[family-name:var(--font-body)] text-xl sm:text-2xl mt-4 mb-10 max-w-md mx-auto">This page is gone. Your rankings don't have to be.</p>
      <a href="/" class="btn-shimmer inline-block bg-[#F59E0B] text-[#0A0A0A] px-8 py-4 rounded-lg font-[family-name:var(--font-heading)] font-bold text-lg hover:brightness-110 transition-all">Back to Home</a>
    </div>
  </section>
</Base>

<style>
  .dot-grid {
    background-image: radial-gradient(circle, rgba(245,158,11,0.3) 1px, transparent 1px);
    background-size: 32px 32px;
  }
</style>
