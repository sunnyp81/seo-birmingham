---
import Base from '../../layouts/Base.astro';

const title = 'SEO Services Birmingham | SEO Birmingham';
const description = 'SEO Birmingham runs technical audits, local search, content strategy, link building, and AI search optimisation for businesses across Birmingham and the West Midlands.';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'SEO Services Birmingham',
  provider: {
    '@type': 'Organization',
    name: 'SEO Birmingham',
    url: 'https://seo-birmingham.uk/',
    sameAs: [],
  },
  areaServed: {
    '@type': 'Place',
    name: 'Birmingham, West Midlands',
  },
  serviceType: 'Search Engine Optimisation',
  description: 'SEO Birmingham provides full-service SEO for Birmingham businesses including technical SEO, local SEO, content strategy, link building, and AI search optimisation.',
};

const faqData = [
  {
    question: 'How fast do Birmingham businesses see SEO results?',
    answer: 'Most of our Birmingham clients see ranking gains within 3 to 6 months. Brutal sectors like legal in Colmore Business District or jewellery retail in the Jewellery Quarter take longer, the competition is entrenched. Local SEO wins come faster. Google Business Profile optimisation can shift the needle in 4 to 8 weeks.',
  },
  {
    question: 'Which SEO services move the needle most for Birmingham companies?',
    answer: 'Local SEO hits hardest for businesses with a physical presence, Google Business Profile, map pack, citations. Technical SEO stops you leaking rankings through crawl issues and slow pages. Content programmes lock in topical authority. Businesses near the Bullring or Grand Central also need tight citation management to hold local positions.',
  },
  {
    question: 'What does SEO cost in Birmingham?',
    answer: 'Depends on scope and how hard the competition fights. Monthly retainers for SMEs run £500 to £3,000. Standalone audits start at £300. We publish full pricing and Birmingham-specific packages on our pricing page.',
  },
  {
    question: 'Do you work with startups in the Custard Factory and Digbeth?',
    answer: 'We do. Tech startups, creative studios, makers, we work with them at the Custard Factory, Innovation Birmingham Campus, and across Digbeth. Startup work focuses on building topical authority fast, grabbing long-tail keywords with less competition, and nailing the technical foundation before scaling spend.',
  },
  {
    question: 'What is AI search optimisation and why should Birmingham businesses care?',
    answer: 'AI search optimisation gets your business cited by ChatGPT, Perplexity, and Google AI Overviews. AI answers are eating traditional clicks. If you are not in those responses, you are invisible to a growing chunk of your market. We structure your content, entity signals, and authority markers so AI systems name your business when users ask relevant questions.',
  },
  {
    question: 'Can you run multi-location SEO across Birmingham?',
    answer: 'Yes. We build multi-location strategies spanning Birmingham, Solihull, Wolverhampton, Coventry, and the wider West Midlands. Each location gets its own landing page, a tailored Google Business Profile strategy, and area-specific citations. No thin duplicate pages.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqData.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const services = [
  {
    title: 'Technical SEO',
    href: '/technical-seo-birmingham/',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.048.58.024 1.194-.14 1.743" /></svg>`,
    summary: 'Site architecture, crawl budget, Core Web Vitals, structured data, JavaScript rendering, internal linking, and indexation controls. We audit every layer.',
    detail: 'We see this constantly across Birmingham, corporate sites in Colmore Business District on legacy CMS platforms, fast-shipping startups at the Custard Factory skipping fundamentals. Both pay the price. For larger Birmingham businesses running complex sites, we provide ongoing technical monitoring. Platform migrations and CMS transitions are the highest-risk moments for SEO, and the biggest openings to leapfrog competitors who botch theirs.',
  },
  {
    title: 'SEO Audits',
    href: '/seo-audit-birmingham/',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15a2.25 2.25 0 012.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" /></svg>`,
    summary: 'Over 200 ranking factors checked, technical health, content quality, backlink profile, and competitive positioning within Birmingham.',
    detail: 'You get a prioritised action plan. Ranked by impact. Ranked by effort. It tells you exactly what is dragging you down and the order to fix it. Audits hit hardest for Birmingham businesses that have switched agencies, rebuilt their site, or watched rankings drop without explanation. We find the root cause. We map the recovery.',
  },
  {
    title: 'Free SEO Audit',
    href: '/free-seo-audit-birmingham/',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" /></svg>`,
    summary: 'A quick-hit assessment covering the critical fundamentals. Surfaces the biggest opportunities before you commit to a full engagement.',
    detail: 'Want a quick look before investing in a full audit? Our free SEO audit covers the critical fundamentals and surfaces the biggest opportunities holding your Birmingham business back.',
  },
  {
    title: 'Local SEO',
    href: null,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>`,
    summary: 'Google Business Profile, map pack, citations, review strategy, local landing pages, and NAP consistency across Birmingham districts.',
    detail: 'If you have a physical presence, restaurant in the Balti Triangle, professional services firm at Brindleyplace, shop near the Bullring, local visibility converts directly to footfall and enquiries. Birmingham\'s local search landscape fragments across distinct districts. Edgbaston plays differently to Sutton Coldfield. We calibrate strategy to your specific area.',
  },
  {
    title: 'Content SEO & Topical Authority',
    href: null,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.331 0 4.471.89 6.063 2.352M12 6.042a8.967 8.967 0 0118 3.75c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.352M12 6.042V20.354" /></svg>`,
    summary: 'We map the complete topic space around your services, find the questions Birmingham customers actually search, and produce content that beats competing answers.',
    detail: 'This is not speculative blogging. Every piece has a defined role in the ranking strategy and a measurable commercial target. Sectors with deep topical requirements, finance, healthcare, legal, gain the most from structured content programmes. We align everything with E-E-A-T standards.',
  },
  {
    title: 'AI Search Optimisation',
    href: '/ai-search-optimisation-birmingham/',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" /></svg>`,
    summary: 'Get cited by ChatGPT, Perplexity, and Google AI Overviews. Entity optimisation, structured data, and content formatted for AI extraction.',
    detail: 'AI search is changing how people find Birmingham businesses. If you are not in those AI responses, you are losing ground to competitors who are. For Birmingham professional services firms, this is becoming non-negotiable.',
  },
  {
    title: 'Link Building & Digital PR',
    href: null,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" /></svg>`,
    summary: 'Authoritative, contextually relevant links from sources search engines trust. Local citations, sector publications, and data-driven digital PR.',
    detail: 'We do not buy junk links. We secure placements through relationships, data-driven content, and strategic outreach. Businesses targeting the NEC exhibition circuit or the Bullring retail cluster get event-based and partnership link opportunities their competitors miss. Every link strengthens domain authority and reinforces the entity signals AI search engines use.',
  },
  {
    title: 'SEO Pricing',
    href: '/seo-pricing-birmingham/',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" /></svg>`,
    summary: 'Transparent, fixed-price packages for Birmingham businesses at every growth stage. One-off audits, local campaigns, or full-service monthly retainers.',
    detail: 'Monthly retainers for SMEs run £500 to £3,000. Standalone audits start at £300. Need a custom proposal for your specific situation? Talk to us.',
  },
];
---

<Base title={title} description={description} schema={[serviceSchema, faqSchema]}>

  <section class="bg-brand text-white py-20 lg:py-28">
    <div class="max-w-6xl mx-auto px-4">
      <div class="max-w-3xl">
        <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight fade-up" style="--i:0">SEO Services Birmingham</h1>
        <div class="quick-answer mt-8 fade-up" style="--i:1">
          <strong>Quick answer:</strong> We do end-to-end SEO for Birmingham businesses. Technical audits. Content strategy. Local search. AI search optimisation. Every piece built around how this city actually works, not a template shipped from London.
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-24">
    <div class="max-w-6xl mx-auto px-4">
      <div class="max-w-3xl fade-up" style="--i:0">
        <p class="text-lg leading-relaxed text-neutral-700">Birmingham is one of the hardest search markets in the UK. Financial services packed into Colmore Business District. Advanced manufacturing running the M42 corridor. Creative industries anchored by the Custard Factory. Thousands of independent retailers and professional services firms scrapping for visibility. Generic SEO playbooks die here.</p>
      </div>
      <div class="max-w-3xl mt-6 fade-up" style="--i:1">
        <p class="text-lg leading-relaxed text-neutral-700">We build strategies around Birmingham's commercial geography, seasonal search patterns, and sector-specific demand. Law firm chasing local pack dominance? Jewellery Quarter retailer targeting product queries? SaaS company at Innovation Birmingham Campus building organic acquisition? Different problems. Different solutions. Same rigour.</p>
      </div>
      <div class="max-w-3xl mt-6 fade-up" style="--i:2">
        <p class="text-lg leading-relaxed text-neutral-700">Every engagement starts with data. We assess current visibility, run a full technical audit, map the competitive landscape across Birmingham, and build a prioritised roadmap. Highest revenue impact first. No guesswork. No filler.</p>
      </div>
    </div>
  </section>

  <section class="bg-neutral-50 py-16 lg:py-24">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-brand text-center fade-up" style="--i:0">What We Do</h2>
      <p class="text-center text-neutral-600 mt-4 max-w-2xl mx-auto fade-up" style="--i:1">Full-service SEO built for Birmingham's competitive landscape.</p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
        {services.map((s, i) => (
          <div class="service-card fade-up stagger-child" style={`--i:${i}`}>
            <div class="text-amber-500 mb-4" set:html={s.icon} />
            <h3 class="font-heading text-xl font-bold text-brand mb-2">
              {s.href ? <a href={s.href} class="hover:text-amber-500 transition-colors">{s.title}</a> : s.title}
            </h3>
            <p class="text-neutral-600 text-sm leading-relaxed mb-3">{s.summary}</p>
            <p class="text-neutral-500 text-sm leading-relaxed">{s.detail}</p>
            {s.href && (
              <a href={s.href} class="inline-flex items-center text-amber-500 font-semibold text-sm mt-4 hover:text-amber-600 transition-colors">
                Learn more
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-brand py-16 lg:py-24">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-white text-center fade-up" style="--i:0">Birmingham SEO in Numbers</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-12">
        <div class="stat-card fade-up stagger-child" style="--i:0">
          <span class="counter-value text-4xl font-bold text-amber-500 font-heading" data-count="200" data-suffix="+">0+</span>
          <p class="text-neutral-300 mt-2 text-sm">Ranking factors audited</p>
        </div>
        <div class="stat-card fade-up stagger-child" style="--i:1">
          <span class="counter-value text-4xl font-bold text-amber-500 font-heading" data-count="6" data-suffix="">0</span>
          <p class="text-neutral-300 mt-2 text-sm">Core SEO services</p>
        </div>
        <div class="stat-card fade-up stagger-child" style="--i:2">
          <span class="counter-value text-4xl font-bold text-amber-500 font-heading" data-count="3" data-suffix="-6 mo">0</span>
          <p class="text-neutral-300 mt-2 text-sm">Typical time to ranking gains</p>
        </div>
        <div class="stat-card fade-up stagger-child" style="--i:3">
          <span class="counter-value text-4xl font-bold text-amber-500 font-heading" data-count="300" data-suffix="">0</span>
          <p class="text-neutral-300 mt-2 text-sm">Audits starting from (£)</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-24">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-brand text-center fade-up" style="--i:0">Frequently Asked Questions</h2>
      <div class="max-w-3xl mx-auto mt-12 space-y-4">
        {faqData.map((faq, i) => (
          <details class="group border border-neutral-200 rounded-lg fade-up stagger-child" style={`--i:${i}`}>
            <summary class="flex items-center justify-between cursor-pointer px-6 py-4 font-heading font-semibold text-brand text-lg hover:text-amber-500 transition-colors">
              {faq.question}
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0 ml-4 text-amber-500 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
            </summary>
            <div class="px-6 pb-5 text-neutral-600 leading-relaxed">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-16 lg:pb-24">
    <div class="max-w-6xl mx-auto px-4">
      <div class="cta-box fade-up" style="--i:0">
        <h2 class="font-heading text-3xl font-bold text-white mb-4">Get the Audit</h2>
        <p class="text-neutral-300 max-w-xl mx-auto mb-8">Find out exactly where your Birmingham business stands in search. Technical health. Local visibility. The ranking opportunities with the highest revenue potential. No obligation.</p>
        <a href="/contact/" class="btn-shimmer">Get the Audit</a>
      </div>
    </div>
  </section>

</Base>
