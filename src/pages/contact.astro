---
import Base from '../layouts/Base.astro';

const title = 'Contact SEO Birmingham | Talk to Us';
const description = 'Get in touch with SEO Birmingham. Fill in the form or email hello@seo-birmingham.uk. We reply within one business day. No sales pressure.';

const faqItems = [
  {
    question: 'How quickly do you respond?',
    answer: 'Within one business day. Messages received before 3pm are usually answered the same day. If it\'s urgent, say so in your message and we\'ll prioritise it.',
  },
  {
    question: 'Do you offer a free initial assessment?',
    answer: 'Yes. We provide a complimentary assessment of your search visibility and competitive positioning in Birmingham. You can also request a full audit through our dedicated audit page. No obligation to proceed.',
  },
  {
    question: 'Do you work with businesses outside Birmingham?',
    answer: 'Our core patch is Birmingham, Solihull, and the wider West Midlands. We also work with UK businesses that need organic visibility in the Birmingham market. Technical SEO and AI search services are delivered remotely regardless of location.',
  },
  {
    question: 'What should we prepare before getting in touch?',
    answer: 'Your website URL, a brief description of your business, and your objectives. Access to Google Search Console or Google Analytics speeds things up. Don\'t have that to hand? No problem. We\'ll guide you through what we need.',
  },
];

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'SEO Birmingham',
  url: 'https://seo-birmingham.uk',
  email: 'hello@seo-birmingham.uk',
  sameAs: [],
  openingHours: 'Mo-Fr 09:00-17:00',
  areaServed: [
    { '@type': 'City', name: 'Birmingham' },
    { '@type': 'City', name: 'Solihull' },
    { '@type': 'City', name: 'Sutton Coldfield' },
    { '@type': 'AdministrativeArea', name: 'West Midlands' },
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    email: 'hello@seo-birmingham.uk',
    availableLanguage: 'English',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<Base title={title} description={description} schema={[localBusinessSchema, faqSchema]}>
  <div class="max-w-3xl mx-auto px-4 py-12 prose">
    <h1>Talk to Us</h1>

    <div class="quick-answer">
      <strong>Get in touch:</strong> Fill in the form below or email <a href="mailto:hello@seo-birmingham.uk">hello@seo-birmingham.uk</a>. We reply within one business day. No obligation. No sales pressure.
    </div>

    <p>We work with businesses across Birmingham, Solihull, and the wider West Midlands. Whether you need a technical audit, a local SEO strategy, or AI search readiness — tell us what you're after. We'll come back with an honest assessment.</p>

    <p>We serve professional services firms in <strong>Colmore Business District</strong>, retailers in the <strong>Jewellery Quarter</strong>, tech companies in <strong>Digbeth</strong>, dental practices in <strong>Edgbaston</strong>, and manufacturers across the <strong>Black Country</strong>. Every engagement starts with understanding your goals and your current search performance.</p>

    <h2>Coverage Areas</h2>

    <ul>
      <li>Birmingham city centre (Colmore Business District, Bullring, Grand Central)</li>
      <li>Edgbaston</li>
      <li>Digbeth</li>
      <li>Jewellery Quarter</li>
      <li>Solihull</li>
      <li>Sutton Coldfield</li>
      <li>Wider West Midlands (Wolverhampton, Coventry, Walsall, Dudley)</li>
    </ul>

    <p>If you operate in these areas, our <a href="/services/">SEO services</a> are built to increase your organic visibility where your customers search.</p>

    <h2>Send Us Your Details</h2>

    <form action="#" method="POST" class="not-prose bg-surface rounded-xl p-6 sm:p-8 shadow-sm border border-gray-200 mb-8">
      <div class="grid sm:grid-cols-2 gap-5 mb-5">
        <div>
          <label for="name" class="block text-sm font-semibold text-brand-dark mb-1.5">Name <span class="text-red-500">*</span></label>
          <input type="text" id="name" name="name" required autocomplete="name" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white text-text focus:outline-none focus:ring-2 focus:ring-brand focus:border-brand transition-shadow" placeholder="Your name" />
        </div>
        <div>
          <label for="email" class="block text-sm font-semibold text-brand-dark mb-1.5">Email <span class="text-red-500">*</span></label>
          <input type="email" id="email" name="email" required autocomplete="email" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white text-text focus:outline-none focus:ring-2 focus:ring-brand focus:border-brand transition-shadow" placeholder="you@example.com" />
        </div>
      </div>
      <div class="grid sm:grid-cols-2 gap-5 mb-5">
        <div>
          <label for="company" class="block text-sm font-semibold text-brand-dark mb-1.5">Company <span class="text-text-muted text-xs font-normal">(optional)</span></label>
          <input type="text" id="company" name="company" autocomplete="organization" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white text-text focus:outline-none focus:ring-2 focus:ring-brand focus:border-brand transition-shadow" placeholder="Your company name" />
        </div>
        <div>
          <label for="website" class="block text-sm font-semibold text-brand-dark mb-1.5">Website URL <span class="text-text-muted text-xs font-normal">(optional)</span></label>
          <input type="url" id="website" name="website" autocomplete="url" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white text-text focus:outline-none focus:ring-2 focus:ring-brand focus:border-brand transition-shadow" placeholder="https://yoursite.co.uk" />
        </div>
      </div>
      <div class="mb-5">
        <label for="message" class="block text-sm font-semibold text-brand-dark mb-1.5">Message <span class="text-red-500">*</span></label>
        <textarea id="message" name="message" required rows="5" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white text-text focus:outline-none focus:ring-2 focus:ring-brand focus:border-brand transition-shadow resize-y" placeholder="Tell us about your business, your current search performance, and what you want to achieve."></textarea>
      </div>
      <button type="submit" class="w-full sm:w-auto bg-accent hover:bg-accent-light text-brand-dark font-bold px-8 py-3 rounded-lg transition-colors text-base cursor-pointer shadow-sm hover:shadow-md">
        Talk to Us
      </button>
    </form>

    <h2>Email Us Directly</h2>

    <p>Prefer email? Write to <a href="mailto:hello@seo-birmingham.uk">hello@seo-birmingham.uk</a>. We monitor the inbox throughout the working day and reply within one business day.</p>

    <h3>Working Hours</h3>

    <p>Monday to Friday, 9am to 5pm. Birmingham-based, remote-first.</p>

    <h2>Our Location</h2>

    <p>We operate from Birmingham and serve businesses across the city and the wider West Midlands.</p>

    <div class="not-prose rounded-xl overflow-hidden shadow-sm border border-gray-200 mb-8">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d78219.42992867908!2d-1.9536041!3d52.4796992!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4870942d1b417173%3A0xca81fef0aeee7998!2sBirmingham!5e0!3m2!1sen!2suk!4v1"
        width="100%"
        height="300"
        style="border:0;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Map showing Birmingham city centre">
      </iframe>
    </div>

    <div class="cta-box">
      <h2 class="text-white text-xl font-bold mt-0">Get the Audit</h2>
      <p class="text-gray-200 mb-0">Find out how your site performs against Birmingham competitors. No obligation.</p>
      <a href="/free-seo-audit-birmingham/">Get the Audit</a>
    </div>

    <h2>Frequently Asked Questions</h2>

    <div class="faq-section not-prose">
      {faqItems.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <div class="faq-answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <p>Question not covered? Email <a href="mailto:hello@seo-birmingham.uk">hello@seo-birmingham.uk</a> or use the form above. Our <a href="/seo-pricing-birmingham/">pricing page</a> has detailed package breakdowns.</p>
  </div>
</Base>
