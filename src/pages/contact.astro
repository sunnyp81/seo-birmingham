---
import Base from '../layouts/Base.astro';

const title = 'Contact SEO Birmingham | Talk to Us';
const description = 'Get in touch with SEO Birmingham. Fill in the form or email hello@seo-birmingham.uk. We reply within one business day. No sales pressure.';

const faqItems = [
  {
    question: 'How quickly do you respond?',
    answer: 'Within one business day. Messages received before 3pm are usually answered the same day. If it\'s urgent, say so in your message and we\'ll prioritise it.',
  },
  {
    question: 'Do you offer a free initial assessment?',
    answer: 'Yes. We provide a complimentary assessment of your search visibility and competitive positioning in Birmingham. You can also request a full audit through our dedicated audit page. No obligation to proceed.',
  },
  {
    question: 'Do you work with businesses outside Birmingham?',
    answer: 'Our core patch is Birmingham, Solihull, and the wider West Midlands. We also work with UK businesses that need organic visibility in the Birmingham market. Technical SEO and AI search services are delivered remotely regardless of location.',
  },
  {
    question: 'What should we prepare before getting in touch?',
    answer: 'Your website URL, a brief description of your business, and your objectives. Access to Google Search Console or Google Analytics speeds things up. Don\'t have that to hand? No problem. We\'ll guide you through what we need.',
  },
];

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'SEO Birmingham',
  url: 'https://seo-birmingham.uk',
  email: 'hello@seo-birmingham.uk',
  sameAs: [],
  openingHours: 'Mo-Fr 09:00-17:00',
  areaServed: [
    { '@type': 'City', name: 'Birmingham' },
    { '@type': 'City', name: 'Solihull' },
    { '@type': 'City', name: 'Sutton Coldfield' },
    { '@type': 'AdministrativeArea', name: 'West Midlands' },
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    email: 'hello@seo-birmingham.uk',
    availableLanguage: 'English',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<Base title={title} description={description} schema={[localBusinessSchema, faqSchema]}>

  <!-- Hero -->
  <section class="bg-brand relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04] pointer-events-none" style="background-image: radial-gradient(circle, rgba(245,158,11,0.5) 1px, transparent 1px); background-size: 24px 24px;"></div>
    <div class="relative max-w-6xl mx-auto px-4 py-16 sm:py-20 text-center">
      <h1 class="text-white text-4xl sm:text-5xl mb-4 fade-up">Talk to Us</h1>
      <div class="w-16 h-1 bg-accent mx-auto mb-6 fade-up"></div>
      <p class="text-zinc-300 text-lg max-w-2xl mx-auto fade-up">Fill in the form below or email <a href="mailto:hello@seo-birmingham.uk" class="text-accent hover:text-accent-light transition-colors font-semibold underline underline-offset-4 decoration-accent/50">hello@seo-birmingham.uk</a>. We reply within one business day. No obligation. No sales pressure.</p>
    </div>
  </section>

  <!-- Two-Column: Info + Form -->
  <section class="max-w-6xl mx-auto px-4 py-16 sm:py-20">
    <div class="grid lg:grid-cols-5 gap-10 lg:gap-14">

      <!-- Left Column: Info & Benefits -->
      <div class="lg:col-span-2 flex flex-col gap-6">

        <div class="fade-up">
          <p class="text-text leading-relaxed mb-6">We work with businesses across Birmingham, Solihull, and the wider West Midlands. Whether you need a technical audit, a local SEO strategy, or AI search readiness, tell us what you're after. We'll come back with an honest assessment.</p>
          <p class="text-text leading-relaxed">We serve professional services firms in <strong>Colmore Business District</strong>, retailers in the <strong>Jewellery Quarter</strong>, tech companies in <strong>Digbeth</strong>, dental practices in <strong>Edgbaston</strong>, and manufacturers across the <strong>Black Country</strong>. Every engagement starts with understanding your goals and your current search performance.</p>
        </div>

        <!-- Email Card -->
        <div class="service-card fade-up" style="--i:1">
          <h3 class="text-xs font-bold uppercase tracking-widest text-accent mb-3" style="font-family: var(--font-heading);">Email Us Directly</h3>
          <a href="mailto:hello@seo-birmingham.uk" class="text-lg font-bold text-brand-dark hover:text-accent transition-colors" style="font-family: var(--font-heading);">hello@seo-birmingham.uk</a>
          <p class="text-text-muted text-sm mt-2">We monitor the inbox throughout the working day and reply within one business day.</p>
        </div>

        <!-- Hours Card -->
        <div class="service-card fade-up" style="--i:2">
          <h3 class="text-xs font-bold uppercase tracking-widest text-accent mb-3" style="font-family: var(--font-heading);">Working Hours</h3>
          <p class="text-lg font-bold text-brand-dark" style="font-family: var(--font-heading);">Monday to Friday, 9am to 5pm</p>
          <p class="text-text-muted text-sm mt-2">Serving Birmingham, working remotely.</p>
        </div>

        <!-- Location Card -->
        <div class="service-card fade-up" style="--i:3">
          <h3 class="text-xs font-bold uppercase tracking-widest text-accent mb-3" style="font-family: var(--font-heading);">Our Location</h3>
          <p class="text-text-muted text-sm">We serve businesses across Birmingham and the wider West Midlands, working remotely.</p>
        </div>

        <!-- Stats Row -->
        <div class="grid grid-cols-2 gap-4 fade-up" style="--i:4">
          <div class="stat-card">
            <div class="counter-value" data-count="1" data-suffix="">1</div>
            <p class="text-zinc-400 text-xs mt-2 font-medium uppercase tracking-wider relative z-10">Business Day Reply</p>
          </div>
          <div class="stat-card">
            <div class="counter-value" data-count="0" data-suffix="">0</div>
            <p class="text-zinc-400 text-xs mt-2 font-medium uppercase tracking-wider relative z-10">Sales Pressure</p>
          </div>
        </div>

      </div>

      <!-- Right Column: Form -->
      <div class="lg:col-span-3 fade-up">
        <div class="bg-brand rounded-none p-8 sm:p-10 border-t-4 border-accent relative overflow-hidden">
          <div class="absolute inset-0 opacity-[0.04] pointer-events-none" style="background-image: radial-gradient(circle, rgba(245,158,11,0.5) 1px, transparent 1px); background-size: 20px 20px;"></div>
          <div class="relative z-10">
            <h2 class="text-white text-2xl sm:text-3xl font-extrabold mb-1 tracking-tight" style="font-family: var(--font-heading); letter-spacing: -0.03em; border: none; display: block; padding: 0;">Send Us Your Details</h2>
            <p class="text-zinc-400 text-sm mb-8">All fields marked <span class="text-red-400">*</span> are required.</p>

            <div id="form-sent-banner" class="hidden mb-6 p-4 border border-green-500 bg-green-500/10 text-green-400 text-sm font-semibold" role="status">
              Thanks, your message has been sent. We reply within one business day.
            </div>

            <form action="https://api.staticforms.xyz/submit" method="POST" class="space-y-5">
              <input type="hidden" name="accessKey" value="sf_9e906eb6c00416b9d3354749" />
              <input type="hidden" name="_site" value="seo-birmingham.uk" />
              <input type="hidden" name="subject" value="SEO Birmingham: New Enquiry (seo-birmingham.uk)" />
              <input type="hidden" name="redirectTo" value="https://seo-birmingham.uk/contact/?sent=1" />
              <input type="text" name="honeypot" style="display:none" />
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="name" class="block text-xs font-bold uppercase tracking-widest text-accent mb-2">Name <span class="text-red-400">*</span></label>
                  <input type="text" id="name" name="name" required autocomplete="name" class="w-full px-4 py-3 bg-brand-light border border-zinc-700 text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent transition-shadow" placeholder="Your name" />
                </div>
                <div>
                  <label for="email" class="block text-xs font-bold uppercase tracking-widest text-accent mb-2">Email <span class="text-red-400">*</span></label>
                  <input type="email" id="email" name="email" required autocomplete="email" class="w-full px-4 py-3 bg-brand-light border border-zinc-700 text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent transition-shadow" placeholder="name@yourbusiness.co.uk" />
                </div>
              </div>
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="company" class="block text-xs font-bold uppercase tracking-widest text-accent mb-2">Company <span class="text-zinc-500 text-xs font-normal normal-case tracking-normal">(optional)</span></label>
                  <input type="text" id="company" name="company" autocomplete="organization" class="w-full px-4 py-3 bg-brand-light border border-zinc-700 text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent transition-shadow" placeholder="Your company name" />
                </div>
                <div>
                  <label for="website" class="block text-xs font-bold uppercase tracking-widest text-accent mb-2">Website URL <span class="text-zinc-500 text-xs font-normal normal-case tracking-normal">(optional)</span></label>
                  <input type="url" id="website" name="website" autocomplete="url" class="w-full px-4 py-3 bg-brand-light border border-zinc-700 text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent transition-shadow" placeholder="https://yourbusiness.co.uk" />
                </div>
              </div>
              <div>
                <label for="message" class="block text-xs font-bold uppercase tracking-widest text-accent mb-2">Message <span class="text-red-400">*</span></label>
                <textarea id="message" name="message" required rows="5" class="w-full px-4 py-3 bg-brand-light border border-zinc-700 text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent transition-shadow resize-y" placeholder="Tell us about your business, your current search performance, and what you want to achieve."></textarea>
              </div>
              <button type="submit" class="btn-shimmer w-full sm:w-auto cursor-pointer">
                Talk to Us
              </button>
            </form>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Coverage Areas -->
  <section class="bg-surface-alt">
    <div class="max-w-6xl mx-auto px-4 py-16 sm:py-20">
      <h2 class="text-3xl font-extrabold tracking-tight mb-2 fade-up" style="font-family: var(--font-heading); letter-spacing: -0.03em;">Coverage Areas</h2>
      <div class="w-12 h-1 bg-accent mb-8 fade-up"></div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {[
          'Birmingham city centre (Colmore Business District, Bullring, Grand Central)',
          'Edgbaston',
          'Digbeth',
          'Jewellery Quarter',
          'Solihull',
          'Sutton Coldfield',
          'Wider West Midlands (Wolverhampton, Coventry, Walsall, Dudley)',
        ].map((area, i) => (
          <div class="service-card fade-up stagger-child" style={`--i:${i}`}>
            <div class="flex items-start gap-3">
              <span class="inline-block w-2 h-2 bg-accent mt-2 flex-shrink-0"></span>
              <span class="text-sm font-medium text-text">{area}</span>
            </div>
          </div>
        ))}
      </div>
      <p class="text-text-muted mt-8 fade-up">If you operate in these areas, our <a href="/services/" class="text-brand font-semibold underline decoration-accent decoration-2 underline-offset-3 hover:decoration-brand transition-colors">SEO services</a> are built to increase your organic visibility where your customers search.</p>
    </div>
  </section>

  <!-- Map -->
  <section class="max-w-6xl mx-auto px-4 py-16 sm:py-20 fade-up">
    <div class="overflow-hidden border border-zinc-200 shadow-sm">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d78219.42992867908!2d-1.9536041!3d52.4796992!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4870942d1b417173%3A0xca81fef0aeee7998!2sBirmingham!5e0!3m2!1sen!2suk!4v1"
        width="100%"
        height="350"
        style="border:0;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Map showing Birmingham city centre">
      </iframe>
    </div>
  </section>

  <!-- CTA Box -->
  <section class="max-w-6xl mx-auto px-4 pb-16 fade-up">
    <div class="cta-box">
      <h2 class="text-white text-xl font-bold mt-0">Get the Audit</h2>
      <p class="text-gray-200 mb-0">Find out how your site performs against Birmingham competitors. No obligation.</p>
      <a href="/free-seo-audit-birmingham/">Get the Audit</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-surface-alt">
    <div class="max-w-3xl mx-auto px-4 py-16 sm:py-20">
      <h2 class="text-3xl font-extrabold tracking-tight mb-2 fade-up" style="font-family: var(--font-heading); letter-spacing: -0.03em;">Frequently Asked Questions</h2>
      <div class="w-12 h-1 bg-accent mb-8 fade-up"></div>

      <div class="faq-section fade-up">
        {faqItems.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <div class="faq-answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>

      <p class="text-text-muted mt-8 fade-up">Question not covered? Email <a href="mailto:hello@seo-birmingham.uk" class="text-brand font-semibold underline decoration-accent decoration-2 underline-offset-3 hover:decoration-brand transition-colors">hello@seo-birmingham.uk</a> or use the form above. Our <a href="/seo-pricing-birmingham/" class="text-brand font-semibold underline decoration-accent decoration-2 underline-offset-3 hover:decoration-brand transition-colors">pricing page</a> has detailed package breakdowns.</p>
    </div>
  </section>

  <script is:inline>
    // Client-side confirmation: static build cannot read query params server-side.
    if (new URLSearchParams(window.location.search).get('sent') === '1') {
      var b = document.getElementById('form-sent-banner');
      if (b) { b.classList.remove('hidden'); b.scrollIntoView({ block: 'center' }); }
    }
  </script>
</Base>
