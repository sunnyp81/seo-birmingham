---
import Base from '../layouts/Base.astro';

const title = 'Contact — SEO Birmingham';
const description = 'Contact SEO Birmingham for expert search optimisation services across Birmingham and the West Midlands. Free initial consultation for local businesses.';

const faqItems = [
  {
    question: 'How quickly will you respond?',
    answer: 'We aim to respond to all enquiries within one working day. Most messages sent before 3pm are answered the same day. If your project is urgent, mention it in your message and we will prioritise accordingly.',
  },
  {
    question: 'Do you offer free consultations?',
    answer: 'Yes. We offer a free initial consultation where we review your current search visibility and discuss your goals. You can also request a free SEO audit through our dedicated audit page. There is no obligation to proceed after the consultation.',
  },
  {
    question: 'Do you work with businesses outside Birmingham?',
    answer: 'Our primary focus is Birmingham, Solihull, and the wider West Midlands, but we also work with UK businesses that want to improve their visibility in the Birmingham market. Technical SEO and AI search optimisation services are available remotely regardless of location.',
  },
  {
    question: 'What information should I have ready?',
    answer: 'It helps to have your website URL, a brief description of your business, and an idea of your goals — whether that is more local visibility, higher rankings for specific terms, or improved lead generation. If you have access to Google Search Console or Google Analytics, that speeds up our initial assessment. Do not worry if you do not have everything prepared; we can guide you through what we need.',
  },
];

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'SEO Birmingham',
  url: 'https://seo-birmingham.uk',
  email: '2012.infinite@gmail.com',
  openingHours: 'Mo-Fr 09:00-17:00',
  areaServed: [
    { '@type': 'City', name: 'Birmingham' },
    { '@type': 'City', name: 'Solihull' },
    { '@type': 'City', name: 'Sutton Coldfield' },
    { '@type': 'AdministrativeArea', name: 'West Midlands' },
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    email: '2012.infinite@gmail.com',
    availableLanguage: 'English',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<Base title={title} description={description} schema={[localBusinessSchema, faqSchema]}>
  <div class="max-w-3xl mx-auto px-4 py-12 prose">
    <h1>Contact SEO Birmingham</h1>

    <div class="quick-answer">
      <strong>Get in touch:</strong> Fill in the form below or email us directly at <a href="mailto:2012.infinite@gmail.com">2012.infinite@gmail.com</a>. We respond within one working day and offer a free initial consultation for businesses in Birmingham and the West Midlands.
    </div>

    <p>SEO Birmingham provides local search marketing consultancy across Birmingham, Solihull, and the wider West Midlands. Whether you need a technical audit, local SEO strategy, or guidance on AI search optimisation, we are here to help your business grow its organic visibility.</p>

    <p>We work with businesses of all sizes across the region — from independent shops in the <a href="/areas/">Jewellery Quarter</a> and Digbeth to established firms in Edgbaston and Solihull. Every engagement starts with understanding your goals and your current search performance.</p>

    <h2>Areas We Serve</h2>

    <p>Our consultancy covers the following areas in and around Birmingham:</p>

    <ul>
      <li>Birmingham city centre</li>
      <li>Edgbaston</li>
      <li>Digbeth</li>
      <li>Jewellery Quarter</li>
      <li>Solihull</li>
      <li>Sutton Coldfield</li>
      <li>Wider West Midlands (Wolverhampton, Coventry, Walsall, Dudley)</li>
    </ul>

    <p>If your business serves customers in these areas, our <a href="/services/">local SEO services</a> can help you reach them through search.</p>

    <h2>Send Us a Message</h2>

    <form action="#" method="POST" class="not-prose bg-surface rounded-xl p-6 sm:p-8 shadow-sm border border-gray-200 mb-8">
      <div class="grid sm:grid-cols-2 gap-5 mb-5">
        <div>
          <label for="name" class="block text-sm font-semibold text-brand-dark mb-1.5">Name <span class="text-red-500">*</span></label>
          <input type="text" id="name" name="name" required autocomplete="name" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white text-text focus:outline-none focus:ring-2 focus:ring-brand focus:border-brand transition-shadow" placeholder="Your name" />
        </div>
        <div>
          <label for="email" class="block text-sm font-semibold text-brand-dark mb-1.5">Email <span class="text-red-500">*</span></label>
          <input type="email" id="email" name="email" required autocomplete="email" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white text-text focus:outline-none focus:ring-2 focus:ring-brand focus:border-brand transition-shadow" placeholder="you@example.com" />
        </div>
      </div>
      <div class="grid sm:grid-cols-2 gap-5 mb-5">
        <div>
          <label for="phone" class="block text-sm font-semibold text-brand-dark mb-1.5">Phone <span class="text-text-muted text-xs font-normal">(optional)</span></label>
          <input type="tel" id="phone" name="phone" autocomplete="tel" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white text-text focus:outline-none focus:ring-2 focus:ring-brand focus:border-brand transition-shadow" placeholder="07xxx xxxxxx" />
        </div>
        <div>
          <label for="website" class="block text-sm font-semibold text-brand-dark mb-1.5">Website URL <span class="text-text-muted text-xs font-normal">(optional)</span></label>
          <input type="url" id="website" name="website" autocomplete="url" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white text-text focus:outline-none focus:ring-2 focus:ring-brand focus:border-brand transition-shadow" placeholder="https://yoursite.co.uk" />
        </div>
      </div>
      <div class="mb-5">
        <label for="message" class="block text-sm font-semibold text-brand-dark mb-1.5">Message <span class="text-red-500">*</span></label>
        <textarea id="message" name="message" required rows="5" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white text-text focus:outline-none focus:ring-2 focus:ring-brand focus:border-brand transition-shadow resize-y" placeholder="Tell us about your business and what you are looking to achieve with SEO..."></textarea>
      </div>
      <button type="submit" class="w-full sm:w-auto bg-accent hover:bg-accent-light text-brand-dark font-bold px-8 py-3 rounded-lg transition-colors text-base cursor-pointer shadow-sm hover:shadow-md">
        Send Message
      </button>
    </form>

    <h2>Other Ways to Reach Us</h2>

    <p>Prefer email? Contact us directly at <a href="mailto:2012.infinite@gmail.com">2012.infinite@gmail.com</a>. We monitor this inbox throughout the working day.</p>

    <h3>Working Hours</h3>

    <p>Remote-first consultancy. Available Monday to Friday, 9am-5pm.</p>

    <h2>Find Us</h2>

    <p>We are based in Birmingham and serve businesses across the city and the wider West Midlands region.</p>

    <div class="not-prose rounded-xl overflow-hidden shadow-sm border border-gray-200 mb-8">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d78219.42992867908!2d-1.9536041!3d52.4796992!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4870942d1b417173%3A0xca81fef0aeee7998!2sBirmingham!5e0!3m2!1sen!2suk!4v1"
        width="100%"
        height="300"
        style="border:0;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Map showing Birmingham city centre">
      </iframe>
    </div>

    <div class="cta-box">
      <h2 class="text-white text-xl font-bold mt-0">Ready to Improve Your Search Rankings?</h2>
      <p class="text-gray-200 mb-0">Request a free SEO audit and find out where your website stands in Birmingham search results.</p>
      <a href="/free-seo-audit-birmingham/">Get Your Free SEO Audit</a>
    </div>

    <h2>Frequently Asked Questions</h2>

    <div class="faq-section not-prose">
      {faqItems.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <div class="faq-answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <p>Have a question not covered here? <a href="mailto:2012.infinite@gmail.com">Email us</a> or use the form above. You can also explore our <a href="/seo-pricing-birmingham/">pricing page</a> for details on packages and costs.</p>
  </div>
</Base>
