---
import Base from '../layouts/Base.astro';

const title = 'Contact Colmore SEO | Birmingham';
const description = 'Contact Colmore SEO to request a proposal for your Birmingham business. We respond within one business day. Data-led SEO for the West Midlands.';

const faqItems = [
  {
    question: 'How quickly does Colmore SEO respond to enquiries?',
    answer: 'We respond to all enquiries within one business day. Messages received before 3pm are typically answered the same day. If your requirement is time-sensitive, note this in your submission and we will prioritise accordingly.',
  },
  {
    question: 'Does Colmore SEO offer a free initial assessment?',
    answer: 'Yes. We provide a complimentary initial assessment covering your current search visibility and competitive positioning in the Birmingham market. You can also request a detailed SEO audit through our dedicated audit page. There is no obligation to proceed after the assessment.',
  },
  {
    question: 'Does Colmore SEO work with businesses outside Birmingham?',
    answer: 'Our primary coverage area is Birmingham, Solihull, and the wider West Midlands. We also serve UK businesses that need to strengthen their organic presence in the Birmingham market. Technical SEO and AI search optimisation services are delivered remotely regardless of location.',
  },
  {
    question: 'What information should we prepare before making contact?',
    answer: 'Having your website URL, a brief description of your business, and an outline of your objectives will help us respond with a relevant initial assessment. If you have access to Google Search Console or Google Analytics, that accelerates our evaluation. If you do not have these details to hand, we will guide you through what we need during our first exchange.',
  },
];

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Colmore SEO',
  url: 'https://seo-birmingham.uk',
  email: 'hello@seo-birmingham.uk',
  sameAs: [],
  openingHours: 'Mo-Fr 09:00-17:00',
  areaServed: [
    { '@type': 'City', name: 'Birmingham' },
    { '@type': 'City', name: 'Solihull' },
    { '@type': 'City', name: 'Sutton Coldfield' },
    { '@type': 'AdministrativeArea', name: 'West Midlands' },
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    email: 'hello@seo-birmingham.uk',
    availableLanguage: 'English',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<Base title={title} description={description} schema={[localBusinessSchema, faqSchema]}>
  <div class="max-w-3xl mx-auto px-4 py-12 prose">
    <h1>Contact Colmore SEO</h1>

    <div class="quick-answer">
      <strong>Request a proposal:</strong> Complete the form below or email us at <a href="mailto:hello@seo-birmingham.uk">hello@seo-birmingham.uk</a>. We respond within one business day. No obligation, no sales pressure — just a data-backed assessment of your organic search opportunity.
    </div>

    <p>Colmore SEO delivers specialist search optimisation for businesses across Birmingham, Solihull, and the wider West Midlands. Whether you need a technical audit, a local SEO strategy, or guidance on AI search readiness, submit your details and our team will respond with an initial assessment tailored to your market.</p>

    <p>We work with businesses across the region — from professional services firms in <strong>Colmore Business District</strong> and retailers in the <strong>Jewellery Quarter</strong> to technology companies in <strong>Digbeth</strong>, dental practices in <strong>Edgbaston</strong>, and manufacturers across the <strong>Black Country</strong>. Every engagement begins with understanding your commercial objectives and your current search performance.</p>

    <h2>Coverage Areas</h2>

    <p>Our services cover the following areas across Birmingham and the West Midlands:</p>

    <ul>
      <li>Birmingham city centre (Colmore Business District, Bullring, Grand Central)</li>
      <li>Edgbaston</li>
      <li>Digbeth</li>
      <li>Jewellery Quarter</li>
      <li>Solihull</li>
      <li>Sutton Coldfield</li>
      <li>Wider West Midlands (Wolverhampton, Coventry, Walsall, Dudley)</li>
    </ul>

    <p>If your business operates within these areas, our <a href="/services/">local SEO services</a> are designed to increase your organic visibility where your customers are searching.</p>

    <h2>Submit Your Details</h2>

    <form action="#" method="POST" class="not-prose bg-surface rounded-xl p-6 sm:p-8 shadow-sm border border-gray-200 mb-8">
      <div class="grid sm:grid-cols-2 gap-5 mb-5">
        <div>
          <label for="name" class="block text-sm font-semibold text-brand-dark mb-1.5">Name <span class="text-red-500">*</span></label>
          <input type="text" id="name" name="name" required autocomplete="name" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white text-text focus:outline-none focus:ring-2 focus:ring-brand focus:border-brand transition-shadow" placeholder="Your name" />
        </div>
        <div>
          <label for="email" class="block text-sm font-semibold text-brand-dark mb-1.5">Email <span class="text-red-500">*</span></label>
          <input type="email" id="email" name="email" required autocomplete="email" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white text-text focus:outline-none focus:ring-2 focus:ring-brand focus:border-brand transition-shadow" placeholder="you@example.com" />
        </div>
      </div>
      <div class="grid sm:grid-cols-2 gap-5 mb-5">
        <div>
          <label for="company" class="block text-sm font-semibold text-brand-dark mb-1.5">Company <span class="text-text-muted text-xs font-normal">(optional)</span></label>
          <input type="text" id="company" name="company" autocomplete="organization" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white text-text focus:outline-none focus:ring-2 focus:ring-brand focus:border-brand transition-shadow" placeholder="Your company name" />
        </div>
        <div>
          <label for="website" class="block text-sm font-semibold text-brand-dark mb-1.5">Website URL <span class="text-text-muted text-xs font-normal">(optional)</span></label>
          <input type="url" id="website" name="website" autocomplete="url" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white text-text focus:outline-none focus:ring-2 focus:ring-brand focus:border-brand transition-shadow" placeholder="https://yoursite.co.uk" />
        </div>
      </div>
      <div class="mb-5">
        <label for="message" class="block text-sm font-semibold text-brand-dark mb-1.5">Message <span class="text-red-500">*</span></label>
        <textarea id="message" name="message" required rows="5" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 bg-white text-text focus:outline-none focus:ring-2 focus:ring-brand focus:border-brand transition-shadow resize-y" placeholder="Describe your business, your current search performance, and what you are looking to achieve."></textarea>
      </div>
      <button type="submit" class="w-full sm:w-auto bg-accent hover:bg-accent-light text-brand-dark font-bold px-8 py-3 rounded-lg transition-colors text-base cursor-pointer shadow-sm hover:shadow-md">
        Request a Proposal
      </button>
    </form>

    <h2>Email Us Directly</h2>

    <p>Prefer email? Contact us at <a href="mailto:hello@seo-birmingham.uk">hello@seo-birmingham.uk</a>. We monitor this inbox throughout the working day and respond within one business day.</p>

    <h3>Working Hours</h3>

    <p>Monday to Friday, 9am to 5pm. Birmingham-based, remote-first operation.</p>

    <h2>Our Location</h2>

    <p>Colmore SEO operates from Birmingham and serves businesses across the city and the wider West Midlands region.</p>

    <div class="not-prose rounded-xl overflow-hidden shadow-sm border border-gray-200 mb-8">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d78219.42992867908!2d-1.9536041!3d52.4796992!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4870942d1b417173%3A0xca81fef0aeee7998!2sBirmingham!5e0!3m2!1sen!2suk!4v1"
        width="100%"
        height="300"
        style="border:0;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Map showing Birmingham city centre">
      </iframe>
    </div>

    <div class="cta-box">
      <h2 class="text-white text-xl font-bold mt-0">Request a Proposal</h2>
      <p class="text-gray-200 mb-0">Receive a data-backed assessment of your organic search opportunity in the Birmingham market. No obligation.</p>
      <a href="/free-seo-audit-birmingham/">Request a Proposal</a>
    </div>

    <h2>Frequently Asked Questions</h2>

    <div class="faq-section not-prose">
      {faqItems.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <div class="faq-answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <p>Question not addressed above? Email <a href="mailto:hello@seo-birmingham.uk">hello@seo-birmingham.uk</a> or use the form above. Our <a href="/seo-pricing-birmingham/">pricing page</a> provides detailed breakdowns of packages and investment levels.</p>
  </div>
</Base>
