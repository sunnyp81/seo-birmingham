---
import Base from '../layouts/Base.astro';

const title = 'SEO Birmingham | Rank Higher. Get Found.';
const description = 'SEO Birmingham gets your business found. Technical SEO, local search, and AI search optimisation for Birmingham and West Midlands companies. Results you can measure.';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'SEO Birmingham',
  url: 'https://seo-birmingham.uk',
  email: 'hello@seo-birmingham.uk',
  sameAs: [],
  description: 'SEO agency serving Birmingham and the West Midlands.',
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'SEO Birmingham',
  url: 'https://seo-birmingham.uk',
  email: 'hello@seo-birmingham.uk',
  priceRange: '££',
  areaServed: [
    { '@type': 'City', name: 'Birmingham' },
    { '@type': 'City', name: 'Solihull' },
    { '@type': 'City', name: 'Edgbaston' },
    { '@type': 'Place', name: 'Jewellery Quarter' },
    { '@type': 'Place', name: 'Digbeth' },
    { '@type': 'City', name: 'Sutton Coldfield' },
    { '@type': 'City', name: 'Wolverhampton' },
    { '@type': 'City', name: 'Coventry' },
    { '@type': 'AdministrativeArea', name: 'West Midlands' },
  ],
};

const faqItems = [
  {
    question: 'What is a realistic SEO timeline for a Birmingham business?',
    answer: 'Expect measurable ranking movement within 3 to 6 months. Competitive sectors like financial services in Colmore Business District or legal firms along Colmore Row take longer. Lower-competition niches move faster. It depends on your site health, domain authority, and how hard we push.',
  },
  {
    question: 'Why is local SEO critical for Birmingham companies?',
    answer: 'Local SEO puts you in Google Maps, the local pack, and location-specific organic results. Birmingham has 1.1 million people. The wider West Midlands adds millions more. Local SEO captures high-intent traffic from people actively searching for what you sell. That means footfall, calls, and revenue.',
  },
  {
    question: 'What does SEO cost in Birmingham?',
    answer: 'It depends on scope, industry, and keyword difficulty. Monthly retainers for local businesses start from a few hundred pounds and scale with complexity. Our pricing page breaks down exactly what each level includes. No hidden costs.',
  },
  {
    question: 'Do you work with businesses outside Birmingham?',
    answer: 'Yes. We cover Birmingham and the West Midlands, Solihull, Wolverhampton, Coventry, Walsall, Dudley, Sutton Coldfield. We also work with UK-wide businesses that need to crack the Birmingham market specifically.',
  },
  {
    question: 'How does SEO compare to PPC for Birmingham businesses?',
    answer: 'SEO compounds. PPC stops when you stop paying. Over 12 months, SEO typically delivers a lower cost per acquisition for Birmingham businesses. The smartest move is both: PPC for immediate demand, SEO for a durable traffic asset that grows.',
  },
  {
    question: 'How do you measure performance?',
    answer: 'We track keyword positions, organic sessions, click-through rates, and revenue from organic search. Monthly reports pull from Google Search Console, Ahrefs, and our own monitoring tools. Every metric ties to a commercial outcome. We don\'t report vanity numbers.',
  },
  {
    question: 'What is AI search optimisation and should our business invest in it?',
    answer: 'AI search optimisation makes sure your business shows up in ChatGPT, Perplexity, Google AI Overviews, and Microsoft Copilot. These platforms are changing how people find businesses. Without structured data, entity authority, and AI-ready content, you\'ll lose visibility as AI search grows. Invest now or fall behind.',
  },
  {
    question: 'Can you optimise our Google Business Profile?',
    answer: 'Yes. GBP management is built into our local SEO service. We optimise categories, descriptions, photos, review strategy, and posting cadence to maximise local map pack visibility for Birmingham searches. GBP data feeds straight into your monthly report.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const schema = [orgSchema, localBusinessSchema, faqSchema];
---

<Base title={title} description={description} schema={schema}>

  <!-- Hero -->
  <section class="relative bg-brand text-white overflow-hidden min-h-[90vh] flex items-center">
    <!-- Aurora blobs -->
    <div class="absolute top-[-20%] left-[-10%] w-[500px] h-[500px] rounded-full opacity-[0.07] blur-[100px]"
         style="background: radial-gradient(circle, #F59E0B, transparent 70%); animation: aurora-1 8s ease-in-out infinite;"></div>
    <div class="absolute bottom-[-15%] right-[-5%] w-[400px] h-[400px] rounded-full opacity-[0.05] blur-[80px]"
         style="background: radial-gradient(circle, #FBBF24, transparent 70%); animation: aurora-2 12s ease-in-out infinite;"></div>
    <!-- Dot grid -->
    <div class="absolute inset-0 opacity-[0.03]"
         style="background-image: radial-gradient(circle, rgba(245,158,11,0.5) 1px, transparent 1px); background-size: 32px 32px;"></div>

    <div class="relative max-w-6xl mx-auto px-4 py-24 md:py-32 w-full">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Left: copy -->
        <div>
          <p class="text-accent font-bold text-sm uppercase tracking-widest mb-4 fade-up" style="font-family: var(--font-heading);">SEO Birmingham</p>
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-[1.05] mb-6 fade-up" style="--i:1; font-family: var(--font-heading); letter-spacing: -0.04em;">
            Rank Higher.<br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-accent-light">Get Found.</span><br/>
            Grow Revenue.
          </h1>
          <p class="text-zinc-400 text-lg md:text-xl max-w-lg mb-8 fade-up stagger-child" style="--i:2;">
            We get West Midlands businesses found on Google, Google Maps, and AI search platforms. Technical SEO, local search, and AI optimisation, measured by what matters.
          </p>
          <div class="flex flex-wrap gap-4 fade-up stagger-child" style="--i:3;">
            <a href="/free-seo-audit-birmingham/" class="btn-shimmer">Get the Audit</a>
            <a href="/contact/" class="inline-block border-2 border-zinc-600 text-white px-6 py-3 font-bold text-sm uppercase tracking-wider hover:border-accent hover:text-accent transition-colors duration-200" style="font-family: var(--font-heading);">Talk to Us</a>
          </div>
        </div>

        <!-- Right: growth chart SVG -->
        <div class="fade-up stagger-child" style="--i:4;">
          <div class="relative bg-brand-light/50 border border-zinc-800 p-6 md:p-8" style="backdrop-filter: blur(10px);">
            <p class="text-xs uppercase tracking-widest text-zinc-500 mb-4 font-bold">Organic Growth: 12 Months</p>
            <svg viewBox="0 0 400 200" class="w-full h-auto" aria-label="Growth chart showing organic traffic increase over 12 months">
              <!-- Grid lines -->
              <line x1="40" y1="20" x2="40" y2="170" stroke="#27272A" stroke-width="1"/>
              <line x1="40" y1="170" x2="380" y2="170" stroke="#27272A" stroke-width="1"/>
              <line x1="40" y1="120" x2="380" y2="120" stroke="#27272A" stroke-width="0.5" stroke-dasharray="4"/>
              <line x1="40" y1="70" x2="380" y2="70" stroke="#27272A" stroke-width="0.5" stroke-dasharray="4"/>
              <!-- Y labels -->
              <text x="35" y="175" fill="#71717A" font-size="10" text-anchor="end">0</text>
              <text x="35" y="125" fill="#71717A" font-size="10" text-anchor="end">50%</text>
              <text x="35" y="75" fill="#71717A" font-size="10" text-anchor="end">100%</text>
              <text x="35" y="25" fill="#71717A" font-size="10" text-anchor="end">150%</text>
              <!-- X labels -->
              <text x="70" y="188" fill="#71717A" font-size="9" text-anchor="middle">M1</text>
              <text x="155" y="188" fill="#71717A" font-size="9" text-anchor="middle">M4</text>
              <text x="240" y="188" fill="#71717A" font-size="9" text-anchor="middle">M7</text>
              <text x="325" y="188" fill="#71717A" font-size="9" text-anchor="middle">M10</text>
              <text x="370" y="188" fill="#71717A" font-size="9" text-anchor="middle">M12</text>
              <!-- Area fill -->
              <path d="M70,165 C100,160 130,150 155,140 C180,130 210,110 240,90 C270,70 300,50 340,35 L370,25 L370,170 L70,170 Z"
                    fill="url(#areaGradient)" opacity="0.3"/>
              <!-- Growth line -->
              <path class="growth-line"
                    d="M70,165 C100,160 130,150 155,140 C180,130 210,110 240,90 C270,70 300,50 340,35 L370,25"
                    fill="none" stroke="#F59E0B" stroke-width="3" stroke-linecap="round"/>
              <!-- Dot at end -->
              <circle cx="370" cy="25" r="5" fill="#F59E0B" class="growth-line" style="stroke-dasharray:0;stroke-dashoffset:0;opacity:0;transition:opacity 0.5s 2s;">
                <animate attributeName="opacity" from="0" to="1" begin="2s" dur="0.5s" fill="freeze"/>
              </circle>
              <circle cx="370" cy="25" r="10" fill="none" stroke="#F59E0B" opacity="0.3">
                <animate attributeName="r" values="5;15;5" dur="2s" repeatCount="indefinite"/>
                <animate attributeName="opacity" values="0.4;0;0.4" dur="2s" repeatCount="indefinite"/>
              </circle>
              <defs>
                <linearGradient id="areaGradient" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#F59E0B" stop-opacity="0.4"/>
                  <stop offset="100%" stop-color="#F59E0B" stop-opacity="0"/>
                </linearGradient>
              </defs>
            </svg>
            <div class="flex justify-between items-center mt-4 pt-4 border-t border-zinc-800">
              <span class="text-zinc-500 text-xs">Baseline</span>
              <span class="text-accent font-extrabold text-lg" style="font-family: var(--font-heading);">+147% organic</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats row -->
  <section class="bg-brand border-y border-zinc-800">
    <div class="max-w-6xl mx-auto px-4 py-10 grid grid-cols-2 md:grid-cols-4 gap-6">
      <div class="text-center fade-up" style="--i:0;">
        <div class="counter-value" data-count="46" data-suffix="%">0%</div>
        <p class="text-zinc-400 text-sm mt-2">of searches carry local intent</p>
      </div>
      <div class="text-center fade-up" style="--i:1;">
        <div class="counter-value" data-count="78" data-suffix="%">0%</div>
        <p class="text-zinc-400 text-sm mt-2">local mobile searches convert in 24h</p>
      </div>
      <div class="text-center fade-up" style="--i:2;">
        <div class="counter-value" data-count="40" data-suffix="k+">0</div>
        <p class="text-zinc-400 text-sm mt-2">businesses in Birmingham</p>
      </div>
      <div class="text-center fade-up" style="--i:3;">
        <div class="counter-value" data-count="28" data-suffix="bn">0</div>
        <p class="text-zinc-400 text-sm mt-2">annual GDP contribution</p>
      </div>
    </div>
  </section>

  <!-- Quick answer -->
  <section class="max-w-4xl mx-auto px-4 py-16">
    <div class="quick-answer fade-up">
      <strong>Quick Answer:</strong> We're SEO Birmingham. We get West Midlands businesses found on Google, Google Maps, and AI search platforms. Technical SEO, local search, and AI optimisation, all measured by what matters: traffic, leads, and revenue. No fluff. No guesswork. Just results.
    </div>
  </section>

  <!-- Why Birmingham needs local SEO -->
  <section class="max-w-4xl mx-auto px-4 pb-16">
    <div class="prose">
      <h2 class="fade-up">Why Birmingham Businesses Need Local SEO</h2>

      <div class="fade-up">
        <p>Birmingham contributes over 28 billion pounds to the UK economy annually. More than 40,000 businesses are registered here. The <strong>NEC</strong> draws millions of visitors each year. <strong>HS2</strong> is transforming connectivity. Regeneration across Digbeth, Eastside, and Smithfield is accelerating commercial activity. The market is expanding. Search competition is intensifying with it.</p>

        <p>Despite this, too many Birmingham businesses still rely on referrals, legacy brand recognition, or paid ads as their only acquisition channels. Their competitors are investing in organic search and claiming the positions that drive revenue.</p>
      </div>
    </div>
  </section>

  <!-- What makes Birmingham SEO different - Bento grid -->
  <section class="bg-surface py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-12 fade-up" style="font-family: var(--font-heading); letter-spacing: -0.03em;">What Makes Birmingham SEO Different</h2>

      <div class="grid md:grid-cols-2 gap-4">
        <!-- Tall left card -->
        <div class="service-card md:row-span-2 fade-up" style="--i:0;">
          <div class="w-10 h-10 bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="text-xl font-extrabold mb-3" style="font-family: var(--font-heading);">Overlapping Catchment Areas</h3>
          <p class="text-text-muted leading-relaxed">A plumber in Solihull competes with providers in Birmingham city centre, Shirley, and Knowle simultaneously. Google's service area logic doesn't follow council boundaries. We account for these overlaps and target the specific geographies where your customers actually search.</p>
          <p class="text-text-muted leading-relaxed mt-4">Birmingham isn't a monolithic search market. It's a mesh of overlapping commercial zones. Each has distinct competitive characteristics and customer profiles. Effective SEO here demands micro-market awareness.</p>
        </div>
        <!-- Top right -->
        <div class="service-card fade-up stagger-child" style="--i:1;">
          <div class="w-10 h-10 bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          </div>
          <h3 class="text-xl font-extrabold mb-3" style="font-family: var(--font-heading);">Industry Concentration Zones</h3>
          <p class="text-text-muted leading-relaxed"><strong>Colmore Business District</strong> houses one of the UK's densest clusters of financial firms outside London. The <strong>Jewellery Quarter</strong> packs 400+ businesses into a single square mile. <strong>Digbeth</strong> is the city's creative and tech hub. Each needs tailored keyword research.</p>
        </div>
        <!-- Bottom right row -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="service-card fade-up stagger-child" style="--i:2;">
            <div class="w-10 h-10 bg-accent/10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
            </div>
            <h3 class="text-lg font-extrabold mb-2" style="font-family: var(--font-heading);">Multi-Location</h3>
            <p class="text-text-muted text-sm">Precise coordination across Google Business Profiles, location pages, and citations to prevent cannibalisation.</p>
          </div>
          <div class="service-card fade-up stagger-child" style="--i:3;">
            <div class="w-10 h-10 bg-accent/10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
            </div>
            <h3 class="text-lg font-extrabold mb-2" style="font-family: var(--font-heading);">Beat National Brands</h3>
            <p class="text-text-muted text-sm">Google favours locally relevant results. A properly optimised local business outranks chains for Birmingham queries.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services section -->
  <section class="py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-4 fade-up" style="font-family: var(--font-heading); letter-spacing: -0.03em;">Our SEO Services</h2>
      <p class="text-text-muted max-w-2xl mb-12 fade-up stagger-child" style="--i:1;">Focused SEO services built for Birmingham and West Midlands businesses. Every service ties to measurable commercial outcomes.</p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <a href="/services/" class="service-card group fade-up stagger-child" style="--i:0;">
          <div class="w-10 h-10 bg-accent/10 flex items-center justify-center mb-4 group-hover:bg-accent/20 transition-colors">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="text-lg font-extrabold mb-2" style="font-family: var(--font-heading);">Local SEO</h3>
          <p class="text-text-muted text-sm leading-relaxed">GBP management, citation building, review strategy, and geo-targeted content. We put your business in the local map pack.</p>
          <span class="inline-block mt-4 text-accent text-sm font-bold group-hover:translate-x-1 transition-transform duration-200">View services &rarr;</span>
        </a>

        <a href="/technical-seo-birmingham/" class="service-card group fade-up stagger-child" style="--i:1;">
          <div class="w-10 h-10 bg-accent/10 flex items-center justify-center mb-4 group-hover:bg-accent/20 transition-colors">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
          </div>
          <h3 class="text-lg font-extrabold mb-2" style="font-family: var(--font-heading);">Technical SEO</h3>
          <p class="text-text-muted text-sm leading-relaxed">Site speed, crawlability, indexation errors, mobile usability, and structured data. Remove the barriers blocking your rankings.</p>
          <span class="inline-block mt-4 text-accent text-sm font-bold group-hover:translate-x-1 transition-transform duration-200">Learn more &rarr;</span>
        </a>

        <a href="/seo-audit-birmingham/" class="service-card group fade-up stagger-child" style="--i:2;">
          <div class="w-10 h-10 bg-accent/10 flex items-center justify-center mb-4 group-hover:bg-accent/20 transition-colors">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
          </div>
          <h3 class="text-lg font-extrabold mb-2" style="font-family: var(--font-heading);">SEO Audits</h3>
          <p class="text-text-muted text-sm leading-relaxed">Technical health, on-page optimisation, content quality, backlink authority. Prioritised actions with impact estimates.</p>
          <span class="inline-block mt-4 text-accent text-sm font-bold group-hover:translate-x-1 transition-transform duration-200">Request audit &rarr;</span>
        </a>

        <a href="/ai-search-optimisation-birmingham/" class="service-card group fade-up stagger-child" style="--i:3;">
          <div class="w-10 h-10 bg-accent/10 flex items-center justify-center mb-4 group-hover:bg-accent/20 transition-colors">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
          </div>
          <h3 class="text-lg font-extrabold mb-2" style="font-family: var(--font-heading);">AI Search Optimisation</h3>
          <p class="text-text-muted text-sm leading-relaxed">Get cited by ChatGPT, Perplexity, Google AI Overviews, and Copilot. Structured data and entity authority for AI discovery.</p>
          <span class="inline-block mt-4 text-accent text-sm font-bold group-hover:translate-x-1 transition-transform duration-200">Learn more &rarr;</span>
        </a>

        <div class="service-card fade-up stagger-child" style="--i:4;">
          <div class="w-10 h-10 bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
          </div>
          <h3 class="text-lg font-extrabold mb-2" style="font-family: var(--font-heading);">Content Strategy</h3>
          <p class="text-text-muted text-sm leading-relaxed">Targeted keyword clusters, verified user queries, topical authority. Grounded in search data and structured for AI retrieval.</p>
        </div>

        <div class="service-card fade-up stagger-child" style="--i:5;">
          <div class="w-10 h-10 bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
          </div>
          <h3 class="text-lg font-extrabold mb-2" style="font-family: var(--font-heading);">Link Building & Digital PR</h3>
          <p class="text-text-muted text-sm leading-relaxed">Relevant, authoritative links through digital PR, local partnerships, and content-led outreach. Relevance over volume.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Areas we cover -->
  <section class="bg-brand text-white py-16 md:py-24 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]"
         style="background-image: radial-gradient(circle, rgba(245,158,11,0.5) 1px, transparent 1px); background-size: 24px 24px;"></div>
    <div class="relative max-w-6xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-4 fade-up" style="font-family: var(--font-heading); letter-spacing: -0.03em;">Areas We Cover</h2>
      <p class="text-zinc-400 max-w-2xl mb-12 fade-up stagger-child" style="--i:1;">Birmingham city centre is our base. Our coverage extends across the full West Midlands metropolitan area.</p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {[
          { area: 'Birmingham City Centre', desc: 'Colmore, Bullring, Grand Central, The Mailbox, Eastside' },
          { area: 'Edgbaston', desc: 'Professional services, healthcare, higher education' },
