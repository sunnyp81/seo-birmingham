---
import Base from '../layouts/Base.astro';

const title = 'About SEO Birmingham | How We Work';
const description = 'SEO Birmingham is a specialist search agency for the West Midlands. We audit, fix, grow, and report. No lock-in. No fluff. Just measurable organic growth.';

const faqItems = [
  {
    question: 'What kind of SEO agency is SEO Birmingham?',
    answer: 'We\'re a specialist search agency. We don\'t do web design, social media, or paid ads. Every hour goes into organic search — technical SEO, local optimisation, content strategy, and AI search readiness. That focus produces better results than generalist agencies spreading themselves thin.',
  },
  {
    question: 'Do you work with businesses outside Birmingham?',
    answer: 'Birmingham and the wider West Midlands are our core patch — Solihull, Edgbaston, Wolverhampton, Coventry, Sutton Coldfield, and surrounding boroughs. We also work with UK businesses that need to build organic visibility in the Birmingham market specifically. Technical SEO and AI search services are delivered remotely regardless of location.',
  },
  {
    question: 'How is SEO Birmingham different from other agencies?',
    answer: 'We\'re SEO-only. No distractions. Every recommendation comes from search data, not opinion. Our reporting is fully transparent — you see what we do and why. We also run dedicated AI search optimisation, which most traditional agencies haven\'t operationalised yet. And there\'s no lock-in. You stay because we deliver.',
  },
  {
    question: 'Can we see examples of your work?',
    answer: 'Yes. Our case studies page documents real ranking improvements, traffic growth, and revenue impact across multiple industries. We show the data, the strategy, and the commercial outcomes.',
  },
  {
    question: 'What does a typical engagement look like?',
    answer: 'We start with a technical and competitive audit. That sets the baseline. Then we build a prioritised strategy aligned to your goals and budget. Most clients run on a monthly retainer covering technical maintenance, content optimisation, local SEO, and reporting. We also deliver standalone audits and project-scoped work for specific needs.',
  },
];

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'SEO Birmingham',
  url: 'https://seo-birmingham.uk',
  sameAs: [],
  description: 'Specialist SEO agency serving Birmingham and the West Midlands.',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const schema = [orgSchema, faqSchema];
---

<Base title={title} description={description} schema={schema}>
  <div class="max-w-3xl mx-auto px-4 py-12 prose">

    <h1>About SEO Birmingham</h1>

    <div class="quick-answer">
      <strong>Quick Answer:</strong> We're a specialist SEO agency in Birmingham. We get West Midlands businesses found on Google, Maps, and AI search platforms. Data drives every decision. Results are measured by revenue, not vanity metrics. No lock-in contracts.
    </div>

    <section>
      <h2>What We Do</h2>

      <p>We make Birmingham businesses visible where their customers search. We specialise in technical SEO, local search, and AI search optimisation. That's it — we don't dilute our focus with web design, social media, or paid ads.</p>
    </section>

    <section>
      <h2>How We Work</h2>

      <p>Every engagement follows four phases. No shortcuts. No mystery.</p>

      <h3>1. Audit</h3>
      <p>We tear your site apart. Technical health, on-page optimisation, content quality, backlink profile, competitor positioning, local presence. We use Google Search Console, Ahrefs, Bing Webmaster Tools, and our own monitoring infrastructure. The output is a clear baseline and a prioritised list of what's broken and what's leaving money on the table.</p>

      <h3>2. Fix</h3>
      <p>We resolve the technical issues holding you back. Site speed. Crawlability. Indexation errors. Mobile usability. Structured data gaps. Content gets fixed on a broken foundation — we sort the foundation first. Every fix has a projected impact. Every fix gets tracked.</p>

      <h3>3. Grow</h3>
      <p>Once the foundation is solid, we push. Content production targeting verified keyword clusters. Local SEO — Google Business Profile management, citation building, review strategy, location-targeted content. Link acquisition through digital PR, partnerships, and outreach. AI search optimisation to surface your business in ChatGPT, Perplexity, and Google AI Overviews. Every action maps to a commercial outcome.</p>

      <h3>4. Report</h3>
      <p>You see everything. Monthly reports cover what we did, what moved, and what's next. Rankings, organic traffic, click-through rates, conversions, revenue. If something's underperforming, we flag it and present the adjustment plan. No black boxes. No jargon. Just numbers that matter.</p>
    </section>

    <section>
      <h2>What Makes Us Different</h2>

      <h3>Birmingham-Specific Knowledge</h3>
      <p>We work in this market daily. We know that <strong>Colmore Business District</strong> has professional services competition rivalling central London. We know the <strong>Jewellery Quarter</strong> packs 400+ businesses into a square mile. We know <strong>Digbeth</strong> is the creative and tech hub. We know how Google handles the overlapping search areas across Solihull, Wolverhampton, Coventry, and the Black Country. That local intelligence shapes everything we build.</p>

      <h3>AI Search Capability</h3>
      <p>ChatGPT, Perplexity, Google AI Overviews, Microsoft Copilot — these platforms are changing how people find businesses. We optimise your structured data, entity authority, and content architecture so AI systems cite and recommend you. Most agencies haven't caught up yet. We have.</p>

      <h3>No Lock-In</h3>
      <p>We keep clients through results, not penalty clauses. Our engagements run month to month. You stay because the work delivers ROI, not because a contract forces you. Performance is the only retention mechanism we need.</p>

      <h3>Full Transparency</h3>
      <p>You see what we do, why we do it, and what it produces. Every recommendation is backed by data. Every report shows the evidence. No unexplained line items. No vague "optimisation activities". Specifics only.</p>

      <h3>Direct Access</h3>
      <p>You talk to the team doing the work. No account management layers. Questions answered within one business day.</p>
    </section>

    <section>
      <h2>Industries We Serve</h2>

      <p>Birmingham's economy is commercially diverse. We maintain sector-specific keyword research, competitive intelligence, and content frameworks for these verticals:</p>

      <ul>
        <li><strong>Financial and Professional Services</strong> — accountants, solicitors, financial advisers, consultants</li>
        <li><strong>Legal Services</strong> — family law, commercial litigation, personal injury, employment law, conveyancing</li>
        <li><strong>Jewellery and Luxury Retail</strong> — engagement rings, bespoke jewellery, watch retail, luxury accessories</li>
        <li><strong>Manufacturing and Engineering</strong> — precision engineering, industrial supplies, contract manufacturing</li>
        <li><strong>Healthcare and Dental</strong> — private dental practices, specialist clinics, physiotherapy, cosmetic treatments</li>
        <li><strong>Hospitality and Food</strong> — restaurants, hotels, event venues, catering</li>
        <li><strong>Technology and SaaS</strong> — software companies, digital agencies, IT services</li>
        <li><strong>Construction and Property</strong> — building contractors, estate agents, property management, architects</li>
      </ul>

      <p>Each sector has its own content authority requirements, keyword difficulty profile, and conversion patterns. Our vertical experience means we deploy proven strategies instead of starting from scratch. <a href="/industries/">View all industries</a>.</p>
    </section>

    <section>
      <h2>Coverage</h2>

      <p>We serve businesses across Birmingham and the wider West Midlands:</p>

      <ul>
        <li><strong>Birmingham City Centre</strong> — Colmore Business District, Bullring, Grand Central, The Mailbox, Eastside</li>
        <li><strong>Edgbaston</strong> — professional services, healthcare, education</li>
        <li><strong>Jewellery Quarter</strong> — retail, creative, hospitality</li>
        <li><strong>Digbeth</strong> — tech, creative agencies, food and drink</li>
        <li><strong>Solihull, Sutton Coldfield, Wolverhampton, Coventry</strong></li>
        <li><strong>Walsall, Dudley, West Bromwich, Sandwell</strong></li>
      </ul>

      <p>Search dynamics differ sharply between these areas. We build strategies that account for each geography's competitive landscape. <a href="/areas/">View all areas</a>.</p>
    </section>

    <div class="cta-box">
      <h2 style="color: white; margin-top: 0;">Get the Audit</h2>
      <p>Find out where you stand in Birmingham search. We'll assess your technical health, local visibility, and competitive positioning. No obligation. We reply within one business day.</p>
      <a href="/free-seo-audit-birmingham/">Get the Audit</a>
    </div>

    <section class="faq-section">
      <h2>Frequently Asked Questions</h2>

      {faqItems.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <div class="faq-answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </section>

  </div>
</Base>
