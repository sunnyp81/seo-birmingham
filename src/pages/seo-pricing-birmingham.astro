---
import Base from '../layouts/Base.astro';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "SEO Services Birmingham",
  "provider": {
    "@type": "Organization",
    "name": "SEO Birmingham",
    "url": "https://seo-birmingham.uk",
    "email": "hello@seo-birmingham.uk",
    "sameAs": []
  },
  "areaServed": "Birmingham, West Midlands",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "SEO Pricing Plans",
    "itemListElement": [
      {
        "@type": "Offer",
        "name": "Starter SEO",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "497",
          "priceCurrency": "GBP",
          "unitText": "monthly"
        }
      },
      {
        "@type": "Offer",
        "name": "Growth SEO",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "997",
          "priceCurrency": "GBP",
          "unitText": "monthly"
        }
      },
      {
        "@type": "Offer",
        "name": "Enterprise SEO",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "1997",
          "priceCurrency": "GBP",
          "unitText": "monthly"
        }
      },
      {
        "@type": "Offer",
        "name": "One-Off SEO Audit",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "497",
          "priceCurrency": "GBP",
          "unitText": "one-off"
        }
      }
    ]
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does SEO cost in Birmingham?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Between £497 and £2,500 per month. The number depends on your site size, your competition, and how fast you want to move. That is 30-40% less than London for the same deliverables."
      }
    },
    {
      "@type": "Question",
      "name": "Why is Birmingham SEO cheaper than London?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Overheads. Office space in the Colmore Business District runs roughly half of City of London rates. Salaries and business rates follow. We pass that saving straight to you. The talent is the same — many Birmingham SEO practitioners cut their teeth at top London agencies."
      }
    },
    {
      "@type": "Question",
      "name": "Are there any long-term contracts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Every SEO Birmingham plan is rolling monthly. No lock-in. We recommend six months minimum so the compounding kicks in, but you can leave with 30 days notice. If results stall, you walk. That keeps us sharp."
      }
    },
    {
      "@type": "Question",
      "name": "How long before I see results from SEO?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Technical fixes and Google Business Profile wins land in weeks. Measurable ranking gains take 3-6 months. Competitive terms in law or finance can take 6-12 months to crack page one. No honest agency will promise faster."
      }
    },
    {
      "@type": "Question",
      "name": "What is included in the SEO audit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Technical health. Core Web Vitals. Keyword gaps. Competitor benchmarks. A prioritised action plan you can execute yourself or hand to us. It is a diagnostic, not a sales pitch."
      }
    },
    {
      "@type": "Question",
      "name": "Can I upgrade or downgrade my plan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Switch between Starter, Growth, and Enterprise whenever you want. Most clients start with the audit, move to Starter, then scale to Growth once data confirms traction. Changes hit the next billing cycle."
      }
    }
  ]
};
---

<Base
  title="SEO Pricing Birmingham | SEO Birmingham"
  description="Transparent SEO pricing for Birmingham businesses. Monthly retainers from £497. No lock-in. Save up to 40% versus London agencies."
  schema={[serviceSchema, faqSchema]}
>

  <!-- Hero -->
  <section class="relative bg-brand text-white overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04] pointer-events-none" style="background-image: radial-gradient(circle, rgba(245,158,11,0.5) 1px, transparent 1px); background-size: 24px 24px;"></div>
    <div class="absolute -bottom-32 left-1/2 -translate-x-1/2 w-[600px] h-[300px] rounded-full opacity-[0.08] blur-[80px]" style="background: radial-gradient(circle, #F59E0B, transparent 70%);"></div>
    <div class="relative max-w-6xl mx-auto px-4 py-20 md:py-28 text-center">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-6 fade-up" style="font-family: var(--font-heading); letter-spacing: -0.03em;">SEO Pricing Birmingham</h1>
      <p class="text-lg md:text-xl text-zinc-300 max-w-2xl mx-auto mb-10 fade-up stagger-child" style="--i:1">London charges £3,000. We charge £997. Same work. Better results. Birmingham businesses pay 30-40% less than London for equivalent SEO because our overheads are lower. Not our standards.</p>
      <div class="flex flex-wrap justify-center gap-8 fade-up stagger-child" style="--i:2">
        <div class="stat-card rounded-lg px-8 py-6">
          <div class="counter-value" data-count="40" data-suffix="%">0%</div>
          <div class="text-sm text-zinc-400 mt-2 font-medium">Below London Rates</div>
        </div>
        <div class="stat-card rounded-lg px-8 py-6">
          <div class="counter-value text-white" style="font-size: 2.5rem;">£497</div>
          <div class="text-sm text-zinc-400 mt-2 font-medium">Starting Monthly</div>
        </div>
        <div class="stat-card rounded-lg px-8 py-6">
          <div class="counter-value" data-count="0" data-suffix="">0</div>
          <div class="text-sm text-zinc-400 mt-2 font-medium">Lock-in Contracts</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Answer -->
  <section class="max-w-6xl mx-auto px-4 -mt-6 relative z-10 fade-up">
    <div class="quick-answer rounded-none md:rounded-lg shadow-xl">
      <strong>Quick answer:</strong> Birmingham SEO retainers run <strong>£497 to £2,500 per month</strong>. That is roughly <strong>40% below London agencies</strong> quoting £1,500-£5,000+ for identical work. One-off audits start at £497. The talent pool is the same &mdash; many Birmingham practitioners built careers at top London agencies before relocating to the West Midlands.
    </div>
  </section>

  <!-- Why Pricing Varies -->
  <section class="max-w-6xl mx-auto px-4 py-16 md:py-20">
    <div class="max-w-3xl">
      <h2 class="text-3xl md:text-4xl font-extrabold mb-6 fade-up" style="font-family: var(--font-heading); border-bottom: 3px solid var(--color-accent); display: inline-block; padding-bottom: 0.5rem;">Why Pricing Varies Between Businesses</h2>
      <p class="text-lg text-text-muted mb-6 fade-up">Every business faces a different fight. A Jewellery Quarter retailer chasing "bespoke engagement rings Birmingham" lives in a different world from a Colmore Row solicitor targeting "commercial solicitors West Midlands." Pricing reflects that gap.</p>
      <p class="text-lg text-text-muted mb-8 fade-up">Three things set your price:</p>
    </div>
    <div class="grid md:grid-cols-3 gap-6 mb-10">
      <div class="service-card rounded-lg fade-up stagger-child" style="--i:0">
        <div class="w-12 h-12 bg-surface flex items-center justify-center rounded-lg mb-4">
          <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/></svg>
        </div>
        <h3 class="text-lg font-bold mb-2" style="font-family: var(--font-heading);">Site size and technical debt</h3>
        <p class="text-text-muted text-sm">A 20-page brochure site needs less work than a 5,000-product catalogue. Bigger sites mean more crawl management, internal linking, and content governance.</p>
      </div>
      <div class="service-card rounded-lg fade-up stagger-child" style="--i:1">
        <div class="w-12 h-12 bg-surface flex items-center justify-center rounded-lg mb-4">
          <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
        </div>
        <h3 class="text-lg font-bold mb-2" style="font-family: var(--font-heading);">Keyword competition</h3>
        <p class="text-text-muted text-sm">"Plumber Solihull" is easier than "business insurance Birmingham." Harder keywords demand more content, stronger links, and longer timelines.</p>
      </div>
      <div class="service-card rounded-lg fade-up stagger-child" style="--i:2">
        <div class="w-12 h-12 bg-surface flex items-center justify-center rounded-lg mb-4">
          <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        </div>
        <h3 class="text-lg font-bold mb-2" style="font-family: var(--font-heading);">Industry regulation</h3>
        <p class="text-text-muted text-sm">Finance, health, and legal sites need demonstrable expertise, authoritative backlinks, and professionally reviewed content. That costs more than a standard service page.</p>
      </div>
    </div>
    <p class="text-text-muted max-w-3xl fade-up">We explain exactly which factors apply to you and why the number is what it is. If an agency cannot justify its quote with specifics, walk away.</p>
  </section>

  <!-- Birmingham vs London — dark section -->
  <section class="relative bg-brand text-white overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04] pointer-events-none" style="background-image: radial-gradient(circle, rgba(245,158,11,0.5) 1px, transparent 1px); background-size: 24px 24px;"></div>
    <div class="max-w-6xl mx-auto px-4 py-16 md:py-20 relative">
      <h2 class="text-3xl md:text-4xl font-extrabold mb-6 fade-up" style="font-family: var(--font-heading); border-bottom: 3px solid var(--color-accent); display: inline-block; padding-bottom: 0.5rem;">Birmingham vs London SEO Pricing</h2>
      <p class="text-lg text-zinc-300 max-w-3xl mb-10 fade-up">This is not a quality gap. It is an overheads gap. Office space in the <strong class="text-white">Colmore Business District</strong> runs about £32 per square foot. City of London charges £65+. Salaries and rates follow. We pass those savings straight to clients.</p>

      <div class="overflow-x-auto fade-up">
        <table class="w-full text-sm md:text-base border-collapse">
          <thead>
            <tr>
              <th class="text-left py-4 px-5 text-accent font-bold border-b border-zinc-700" style="font-family: var(--font-heading);">Service</th>
              <th class="text-left py-4 px-5 text-zinc-400 font-bold border-b border-zinc-700" style="font-family: var(--font-heading);">London</th>
              <th class="text-left py-4 px-5 text-white font-bold border-b border-zinc-700" style="font-family: var(--font-heading);">Birmingham</th>
              <th class="text-left py-4 px-5 text-accent font-bold border-b border-zinc-700" style="font-family: var(--font-heading);">Saving</th>
            </tr>
          </thead>
          <tbody class="text-zinc-300">
            <tr class="border-b border-zinc-800 hover:bg-zinc-900/50 transition-colors">
              <td class="py-3.5 px-5 font-medium text-white">Monthly SEO retainer</td>
              <td class="py-3.5 px-5 line-through decoration-zinc-600">£1,500 &ndash; £5,000+</td>
              <td class="py-3.5 px-5 font-bold text-white">£497 &ndash; £2,500</td>
              <td class="py-3.5 px-5 text-accent font-bold">Up to 40%</td>
            </tr>
            <tr class="border-b border-zinc-800 hover:bg-zinc-900/50 transition-colors">
              <td class="py-3.5 px-5 font-medium text-white">One-off SEO audit</td>
              <td class="py-3.5 px-5 line-through decoration-zinc-600">£1,000 &ndash; £3,000</td>
              <td class="py-3.5 px-5 font-bold text-white">£497 &ndash; £1,500</td>
              <td class="py-3.5 px-5 text-accent font-bold">Up to 50%</td>
            </tr>
            <tr class="border-b border-zinc-800 hover:bg-zinc-900/50 transition-colors">
              <td class="py-3.5 px-5 font-medium text-white">Content strategy (per quarter)</td>
              <td class="py-3.5 px-5 line-through decoration-zinc-600">£2,000 &ndash; £6,000</td>
              <td class="py-3.5 px-5 font-bold text-white">£1,000 &ndash; £3,500</td>
              <td class="py-3.5 px-5 text-accent font-bold">Up to 42%</td>
            </tr>
            <tr class="hover:bg-zinc-900/50 transition-colors">
              <td class="py-3.5 px-5 font-medium text-white">Technical SEO overhaul</td>
              <td class="py-3.5 px-5 line-through decoration-zinc-600">£2,500 &ndash; £8,000</td>
              <td class="py-3.5 px-5 font-bold text-white">£1,200 &ndash; £4,000</td>
              <td class="py-3.5 px-5 text-accent font-bold">Up to 50%</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="text-zinc-300 max-w-3xl mt-10 fade-up">The talent question. Birmingham has a deep bench of SEO professionals. Many spent years at London agencies &mdash; Distilled, Builtvisible, Impression &mdash; before relocating. The expertise is identical. The postcode differs. Rankings do not care where the consultant sits.</p>
    </div>
  </section>

  <!-- Pricing Plans -->
  <section class="max-w-6xl mx-auto px-4 py-16 md:py-24">
    <div class="text-center mb-14">
      <h2 class="text-3xl md:text-4xl font-extrabold mb-4 fade-up" style="font-family: var(--font-heading); letter-spacing: -0.03em;">SEO Pricing Plans</h2>
      <p class="text-lg text-text-muted max-w-2xl mx-auto fade-up">Every SEO Birmingham plan includes monthly reporting, no lock-in, and direct access to a senior practitioner. Pick the tier that matches your growth stage.</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-5">

      <!-- Starter -->
      <div class="service-card rounded-xl flex flex-col fade-up stagger-child group" style="--i:0">
        <h3 class="text-lg font-bold mb-1" style="font-family: var(--font-heading);">Starter</h3>
        <div class="flex items-baseline gap-1 mb-1">
          <span class="text-4xl font-extrabold" style="font-family: var(--font-heading); letter-spacing: -0.04em;">£497</span>
          <span class="text-text-muted text-sm font-medium">/mo</span>
        </div>
        <p class="text-sm text-text-muted mb-5">Build the foundation. Fix what is broken.</p>
        <ul class="text-sm space-y-2.5 mb-8 flex-1">
          <li class="flex items-start gap-2.5"><span class="text-accent font-bold mt-0.5">&#10003;</span> Full technical audit</li>
          <li class="flex items-start gap-2.5"><span class="text-accent font-bold mt-0.5">&#10003;</span> Monthly performance report</li>
          <li class="flex items-start gap-2.5"><span class="text-accent font-bold mt-0.5">&#10003;</span> 5 target keywords</li>
          <li class="flex items-start gap-2.5"><span class="text-accent font-bold mt-0.5">&#10003;</span> Core Web Vitals monitoring</li>
          <li class="flex items-start gap-2.5"><span class="text-accent font-bold mt-0.5">&#10003;</span> Google Business Profile optimisation</li>
        </ul>
        <a href="/contact/" class="btn-shimmer text-center !py-2.5 !text-xs !shadow-sm rounded-lg block">Get the Audit</a>
      </div>

      <!-- Growth (popular) -->
      <div class="service-card rounded-xl flex flex-col relative fade-up stagger-child group" style="--i:1; border-top: 4px solid var(--color-accent); transform: scale(1.03); box-shadow: 0 0 40px rgba(245,158,11,0.12), 0 12px 40px rgba(0,0,0,0.08); z-index: 2;">
        <span class="absolute -top-0.5 left-1/2 -translate-x-1/2 -translate-y-full bg-accent text-brand text-xs font-extrabold px-4 py-1.5 rounded-t-lg tracking-wide uppercase" style="font-family: var(--font-heading);">Recommended</span>
        <h3 class="text-lg font-bold mb-1" style="font-family: var(--font-heading);">Growth</h3>
        <div class="flex items-baseline gap-1 mb-1">
          <span class="text-4xl font-extrabold" style="font-family: var(--font-heading); letter-spacing: -0.04em;">£997</span>
          <span class="text-text-muted text-sm font-medium">/mo</span>
        </div>
        <p class="text-sm text-text-muted mb-5">Scale organic traffic. Outrank competitors.</p>
        <ul class="text-sm space-y-2.5 mb-8 flex-1">
          <li class="flex items-start gap-2.5"><span class="text-accent font-bold mt-0.5">&#10003;</span> Everything in Starter</li>
          <li class="flex items-start gap-2.5"><span class="text-accent font-bold mt-0.5">&#10003;</span> Content strategy &amp; production</li>
          <li class="flex items-start gap-2.5"><span class="text-accent font-bold mt-0.5">&#10003;</span> 15 target keywords</li>
          <li class="flex items-start gap-2.5"><span class="text-accent font-bold mt-0.5">&#10003;</span> Link building outreach</li>
          <li class="flex items-start gap-2.5"><span class="text-accent font-bold mt-0.5">&#10003;</span> Monthly strategy call</li>
          <li class="flex items-start gap-2.5"><span class="text-accent font-bold mt-0.5">&#10003;</span> Competitor monitoring</li>
        </ul>
        <a href="/contact/" class="btn-shimmer text-center !py-2.5 !text-xs rounded-lg block">Get the Audit</a>
      </div>

      <!-- Enterprise -->
      <div class="service-card rounded-xl flex flex-col fade-up stagger-child group" style="--i:2">
        <h3 class="text-lg font-bold mb-1" style="font-family: var(--font-heading);">Enterprise</h3>
        <div class="flex items-baseline gap-1 mb-1">
          <span class="text-4xl font-extrabold" style="font-family: var(--font-heading); letter-spacing: -0.04em;">£1,997</span>
          <span class="text-text-muted text-sm font-medium">/mo</span>
        </div>
        <p class="text-sm text-text-muted mb-5">Dominate your sector. Own page one.</p>
        <ul class="text-sm space-y-2.5 mb-8 flex-1">
          <li class="flex items-start gap-2.5"><span class="text-accent font-bold mt-0.5">&#10003;</span> Everything in Growth</li>
          <li class="flex items-start gap-2.5"><span class="text-accent font-bold mt-0.5">&#10003;</span> Dedicated account management</li>
          <li class="flex items-start gap-2.5"><span class="text-accent font-bold mt-0.5">&#10003;</span> 50+ target keywords</li>
          <li class="flex items-start gap-2.5"><span class="text-accent font-bold mt-0.5">&#10003;</span> AI search optimisation</li>
          <li class="flex items-start gap-2.5"><span class="text-accent font-bold mt-0.5">&#10003;</span> Weekly reporting</li>
          <li class="flex items-start gap-2.5"><span class="text-accent font-bold mt-0.5">&#10003;</span> Priority support</li>
        </ul>
        <a href="/contact/" class="btn-shimmer text-center !py-2.5 !text-xs !shadow-sm rounded-lg block">Get the Audit</a>
      </div>

      <!-- One-Off Audit -->
      <div class="service-card rounded-xl flex flex-col fade-up stagger-child group" style="--i:3">
        <h3 class="text-lg font-bold mb-1" style="font-family: var(--font-heading);">One-Off Audit</h3>
        <div class="flex items-baseline gap-1 mb-1">
          <span class="text-4xl font-extrabold" style="font-family: var(--font-heading); letter-spacing: -0.04em;">£497</span>
          <span class="text-text-muted text-sm font-medium"> once</span>
        </div>
        <p class="text-sm text-text-muted mb-5">Know exactly where you stand. No commitment.</p>
        <ul class="text-sm space-y-2.5 mb-8 flex-1">
          <li class="flex items-start gap-2.5"><span class="text-accent font-bold mt-0.5">&#10003;</span> Full technical audit</li>
          <li class="flex items-start gap-2.5"><span class="text-accent font-bold mt-0.5">&#10003;</span> Content gap analysis</li>
          <li class="flex items-start gap-2.5"><span class="text-accent font-bold mt-0.5">&#10003;</span> Competitor benchmarking</li>
          <li class="flex items-start gap-2.5"><span class="text-accent font-bold mt-0.5">&#10003;</span> Prioritised action plan</li>
          <li class="flex items-start gap-2.5"><span class="text-accent font-bold mt-0.5">&#10003;</span> 60-minute walkthrough call</li>
        </ul>
        <a href="/seo-audit-birmingham/" class="btn-shimmer text-center !py-2.5 !text-xs !shadow-sm rounded-lg block">Get the Audit</a>
      </div>

    </div>
  </section>

  <!-- What Every Plan Includes -->
  <section class="bg-surface border-y border-zinc-200">
    <div class="max-w-6xl mx-auto px-4 py-16 md:py-20">
      <h2 class="text-3xl md:text-4xl font-extrabold mb-4 fade-up" style="font-family: var(--font-heading); border-bottom: 3px solid var(--color-accent); display: inline-block; padding-bottom: 0.5rem;">What Every Plan Includes</h2>
      <p class="text-lg text-text-muted mb-10 fade-up">Three commitments. Every tier. No exceptions.</p>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="service-card rounded-lg fade-up stagger-child" style="--i:0">
          <div class="w-10 h-10 bg-accent/10 flex items-center justify-center rounded-lg mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <h3 class="text-lg font-bold mb-2" style="font-family: var(--font-heading);">Transparent reporting</h3>
          <p class="text-sm text-text-muted">Monthly. Google Search Console data, position tracking, traffic numbers, and a plain-English summary. No vanity metrics. No jargon. You see exactly what moved and why.</p>
        </div>
        <div class="service-card rounded-lg fade-up stagger-child" style="--i:1">
          <div class="w-10 h-10 bg-accent/10 flex items-center justify-center rounded-lg mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="text-lg font-bold mb-2" style="font-family: var(--font-heading);">No lock-in</h3>
          <p class="text-sm text-text-muted">Rolling monthly. 30 days notice to leave. We recommend six months so compounding takes hold, but you are never trapped. If we stop delivering, you stop paying. Simple.</p>
