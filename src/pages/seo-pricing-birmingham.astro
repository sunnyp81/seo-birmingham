const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does SEO cost in Birmingham?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Between £497 and £2,500 per month. The number depends on your site size, your competition, and how fast you want to move. That is 30-40% less than London for the same deliverables."
      }
    },
    {
      "@type": "Question",
      "name": "Why is Birmingham SEO cheaper than London?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Overheads. Office space in the Colmore Business District runs roughly half of City of London rates. Salaries and business rates follow. We pass that saving straight to you. The talent is the same — many Birmingham SEO practitioners cut their teeth at top London agencies."
      }
    },
    {
      "@type": "Question",
      "name": "Are there any long-term contracts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Every SEO Birmingham plan is rolling monthly. No lock-in. We recommend six months minimum so the compounding kicks in, but you can leave with 30 days notice. If results stall, you walk. That keeps us sharp."
      }
    },
    {
      "@type": "Question",
      "name": "How long before I see results from SEO?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Technical fixes and Google Business Profile wins land in weeks. Measurable ranking gains take 3-6 months. Competitive terms in law or finance can take 6-12 months to crack page one. No honest agency will promise faster."
      }
    },
    {
      "@type": "Question",
      "name": "What is included in the SEO audit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Technical health. Core Web Vitals. Keyword gaps. Competitor benchmarks. A prioritised action plan you can execute yourself or hand to us. It is a diagnostic, not a sales pitch."
      }
    },
    {
      "@type": "Question",
      "name": "Can I upgrade or downgrade my plan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Switch between Starter, Growth, and Enterprise whenever you want. Most clients start with the audit, move to Starter, then scale to Growth once data confirms traction. Changes hit the next billing cycle."
      }
    }
  ]
};
