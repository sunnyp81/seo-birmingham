---
import Base from '../../layouts/Base.astro';

const title = 'SEO Case Studies Birmingham | SEO Birmingham';
const description = 'Real numbers from real Birmingham campaigns. SEO Birmingham shows what technical SEO, local pack domination, and content strategy deliver across the West Midlands.';

const faqData = [
  {
    question: 'How long before a Birmingham business sees SEO results?',
    answer: 'Most see movement in 3 to 6 months. Local SEO moves faster — Google Business Profile wins can land within weeks. Competitive sectors like legal or jewellery retail take longer. We set expectations upfront with data, not promises.',
  },
  {
    question: 'Are these case studies based on real Birmingham campaigns?',
    answer: 'These are illustrative case studies built from composite results across real West Midlands engagements. Business details are anonymised to protect client confidentiality. The numbers reflect genuine outcomes.',
  },
  {
    question: 'Which Birmingham industries does SEO Birmingham work with?',
    answer: 'Retail, legal, manufacturing, hospitality, professional services, healthcare. Each sector has different search patterns and competition levels. We tailor the approach — no templates.',
  },
  {
    question: 'Can a Birmingham SME outrank national brands?',
    answer: 'Yes. Local SEO gives smaller businesses a structural edge. Google prioritises geographic relevance for local queries. A well-optimised Jewellery Quarter retailer beats national chains for Birmingham-specific searches. We have done it.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqData.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'SEO Case Studies Birmingham',
  description,
  url: 'https://seo-birmingham.uk/case-studies/',
  isPartOf: { '@type': 'WebSite', name: 'SEO Birmingham', url: 'https://seo-birmingham.uk' },
  provider: { '@type': 'Organization', name: 'SEO Birmingham', url: 'https://seo-birmingham.uk', sameAs: [] },
  hasPart: [
    {
      '@type': 'Article',
      name: 'Jewellery Quarter Retailer: 340% Organic Traffic Growth',
      url: 'https://seo-birmingham.uk/case-studies/jewellery-quarter-retailer-organic-growth/',
    },
    {
      '@type': 'Article',
      name: 'Colmore Law Firm: #1 Local Pack in 8 Months',
      url: 'https://seo-birmingham.uk/case-studies/colmore-law-firm-local-pack/',
    },
  ],
};

const schema = [collectionSchema, faqSchema];
---

<Base title={title} description={description} schema={schema} ogType="website">
  <div class="max-w-3xl mx-auto px-4 py-12 prose">
    <h1>Birmingham SEO Case Studies</h1>

    <div class="quick-answer">
      <strong>Numbers talk. These do.</strong> Two Birmingham businesses. One got 340% more organic traffic. The other took #1 in the local pack for 8 practice areas. Here is exactly how.
    </div>

    <p>Birmingham has 46,000+ registered businesses. Standing out takes precision, not guesswork. We audit. We prioritise. We execute. Then we measure. These case studies show what that process delivers in the West Midlands market.</p>

    <p>Every engagement starts the same way: data first. See our <a href="/services/">SEO services</a> for the full scope.</p>
  </div>

  <section class="max-w-4xl mx-auto px-4 py-8">
    <div class="grid md:grid-cols-2 gap-6">
      <a href="/case-studies/jewellery-quarter-retailer-organic-growth/" class="block bg-white border border-gray-200 rounded-xl p-6 shadow-sm hover:shadow-md hover:border-accent transition-all group">
        <span class="text-sm font-semibold text-accent uppercase tracking-wide">Retail</span>
        <h2 class="text-xl font-bold text-brand-dark mt-2 mb-3 group-hover:text-brand transition-colors">Jewellery Quarter Retailer: 340% Organic Traffic Growth</h2>
        <p class="text-text-muted text-sm mb-4">Independent jeweller in Birmingham's Jewellery Quarter. Broken site. Zero local visibility. We fixed the foundations and the traffic followed.</p>
        <div class="flex items-center gap-4">
          <span class="bg-surface-alt px-3 py-1 rounded-full text-sm font-bold text-brand-dark">+340% traffic</span>
          <span class="bg-surface-alt px-3 py-1 rounded-full text-sm font-bold text-brand-dark">12 months</span>
        </div>
      </a>

      <a href="/case-studies/colmore-law-firm-local-pack/" class="block bg-white border border-gray-200 rounded-xl p-6 shadow-sm hover:shadow-md hover:border-accent transition-all group">
        <span class="text-sm font-semibold text-accent uppercase tracking-wide">Legal</span>
        <h2 class="text-xl font-bold text-brand-dark mt-2 mb-3 group-hover:text-brand transition-colors">Colmore Law Firm: #1 Local Pack in 8 Months</h2>
        <p class="text-text-muted text-sm mb-4">Mid-size Colmore Business District law firm. Invisible in local search. We put them at #1 for 8 practice areas and tripled their leads.</p>
        <div class="flex items-center gap-4">
          <span class="bg-surface-alt px-3 py-1 rounded-full text-sm font-bold text-brand-dark">#1 local pack</span>
          <span class="bg-surface-alt px-3 py-1 rounded-full text-sm font-bold text-brand-dark">8 months</span>
        </div>
      </a>
    </div>
  </section>

  <div class="max-w-3xl mx-auto px-4 prose">
    <h2>Why Birmingham SEO Needs a Local-First Approach</h2>

    <p>Birmingham is not London. It is not Manchester. The SEO landscape here is different. Three things set it apart.</p>

    <h3>Concentrated Local Competition</h3>
    <p>The UK's second city. National brands and local independents fight for the same terms. The Bullring, Grand Central, and the Mailbox anchor commercial traffic. Digbeth and the Jewellery Quarter sustain specialist businesses that need hyper-local visibility. A generic SEO approach fails here.</p>

    <h3>Broad Industry Mix</h3>
    <p>Financial services on Colmore Row. Manufacturing in Aston and Tyseley. Creative industries in Digbeth. Retail across the city centre. Each sector has different search patterns, different competition, different conversion paths. One template does not fit.</p>

    <h3>The West Midlands Factor</h3>
    <p>Birmingham businesses serve the wider conurbation — Solihull, Wolverhampton, Walsall, Dudley, Coventry. Good local SEO balances city-centre targeting with regional reach. Service businesses especially need this dual coverage.</p>

    <p>Our case studies reflect strategies built for these dynamics. Want to know where your business stands? <a href="/free-seo-audit-birmingham/">Get the audit</a>.</p>

    <div class="cta-box">
      <h2 class="text-white text-2xl font-bold">Want Numbers Like These?</h2>
      <p class="text-gray-200">We will find your highest-value opportunities and map the path to growth. No fluff. Just data.</p>
      <a href="/free-seo-audit-birmingham/">Get the Audit</a>
    </div>

    <section class="faq-section">
      <h2>Frequently Asked Questions</h2>
      {faqData.map((faq) => (
        <details>
          <summary>{faq.question}</summary>
          <div class="faq-answer">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </section>

    <p>See our <a href="/services/">full range of SEO services</a> or <a href="/contact/">get in touch</a>. We work with businesses across Birmingham and the West Midlands from <a href="/">our base in the city</a>.</p>
  </div>
</Base>
