---
import Base from '../../layouts/Base.astro';

const title = 'SEO Areas — Birmingham & West Midlands';
const description = 'SEO Birmingham delivers local search optimisation across Birmingham city centre, Solihull, Edgbaston, Digbeth, Jewellery Quarter, Sutton Coldfield, and the wider West Midlands.';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Local SEO — Birmingham and West Midlands',
  provider: {
    '@type': 'Organization',
    name: 'SEO Birmingham',
    url: 'https://seo-birmingham.uk/',
    sameAs: [],
  },
  serviceType: 'Local SEO',
  areaServed: [
    { '@type': 'City', name: 'Birmingham' },
    { '@type': 'Place', name: 'Edgbaston' },
    { '@type': 'Place', name: 'Digbeth' },
    { '@type': 'Place', name: 'Jewellery Quarter' },
    { '@type': 'Place', name: 'Solihull' },
    { '@type': 'Place', name: 'Sutton Coldfield' },
    { '@type': 'City', name: 'Wolverhampton' },
    { '@type': 'City', name: 'Coventry' },
    { '@type': 'City', name: 'Walsall' },
    { '@type': 'City', name: 'Dudley' },
    { '@type': 'Place', name: 'West Bromwich' },
    { '@type': 'City', name: 'Tamworth' },
    { '@type': 'City', name: 'Lichfield' },
    { '@type': 'Place', name: 'Bromsgrove' },
    { '@type': 'Place', name: 'Colmore Business District' },
    { '@type': 'Place', name: 'Brindleyplace' },
    { '@type': 'Place', name: 'Birmingham Business Park, Solihull' },
    { '@type': 'Place', name: 'Innovation Birmingham Campus' },
    { '@type': 'Place', name: 'Custard Factory' },
  ],
};

const faqData = [
  {
    question: 'Do you work outside Birmingham city centre?',
    answer: 'We cover the entire West Midlands. Solihull, Wolverhampton, Coventry, Walsall, Dudley, Tamworth, Lichfield, Bromsgrove — each area gets a strategy built from its own competitive data and search demand. Not a copy-paste job.',
  },
  {
    question: 'Why does local SEO differ across Birmingham districts?',
    answer: 'Every district has its own business mix, competitive density, and customer search behaviour. A solicitor in Colmore Business District faces completely different local rivals to a trades business in Sutton Coldfield. Google weights proximity, relevance, and prominence differently depending on query and location. That demands area-specific tactics.',
  },
  {
    question: 'How do you handle multi-location campaigns in the West Midlands?',
    answer: 'We build dedicated landing pages for each location. Optimise individual Google Business Profiles. Develop area-specific citations. Produce content targeting the terms customers in each area actually use. This avoids the thin-content trap that generic multi-location pages create.',
  },
  {
    question: 'Where is SEO competition fiercest in Birmingham?',
    answer: 'Colmore Business District and city centre are the hardest markets for professional services SEO. The Jewellery Quarter is brutal for jewellery and retail queries. Solihull runs hot for property, automotive, and professional services. Suburban areas like Sutton Coldfield and Bromsgrove offer faster wins — less competition, quicker results.',
  },
  {
    question: 'Can you help businesses that serve the whole West Midlands?',
    answer: 'Yes. For regional businesses, we build a hub-and-spoke content architecture. Establish authority in Birmingham first, then extend visibility to surrounding towns and cities. This captures broad West Midlands terms and hyper-local queries in each area.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqData.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Base title={title} description={description} schema={[serviceSchema, faqSchema]}>

  <!-- Hero -->
  <section class="relative bg-brand text-white overflow-hidden py-20 md:py-28">
    <div class="absolute inset-0 opacity-[0.03]"
         style="background-image: radial-gradient(circle, rgba(245,158,11,0.5) 1px, transparent 1px); background-size: 32px 32px;"></div>
    <div class="absolute top-[-15%] left-[-8%] w-[400px] h-[400px] rounded-full opacity-[0.06] blur-[100px]"
         style="background: radial-gradient(circle, #F59E0B, transparent 70%);"></div>

    <div class="relative max-w-6xl mx-auto px-4">
      <p class="text-accent font-bold text-sm uppercase tracking-widest mb-4 fade-up" style="font-family: var(--font-heading);">Areas We Cover</p>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-[1.05] mb-6 fade-up stagger-child" style="--i:1; font-family: var(--font-heading); letter-spacing: -0.04em;">
        SEO Coverage Across Birmingham<br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-accent-light">and the West Midlands</span>
      </h1>
      <p class="text-zinc-400 text-lg md:text-xl max-w-2xl fade-up stagger-child" style="--i:2;">
        Every area strategy is built from local search data and competitive intelligence — not guesswork.
      </p>
    </div>
  </section>

  <!-- Stats row -->
  <section class="bg-brand border-y border-zinc-800">
    <div class="max-w-6xl mx-auto px-4 py-10 grid grid-cols-2 md:grid-cols-4 gap-6">
      <div class="text-center fade-up" style="--i:0;">
        <div class="counter-value" data-count="19" data-suffix="">0</div>
        <p class="text-zinc-400 text-sm mt-2">areas covered</p>
      </div>
      <div class="text-center fade-up" style="--i:1;">
        <div class="counter-value" data-count="500" data-suffix="+">0</div>
        <p class="text-zinc-400 text-sm mt-2">Jewellery Quarter trade businesses</p>
      </div>
      <div class="text-center fade-up" style="--i:2;">
        <div class="counter-value" data-count="40" data-suffix="%">0%</div>
        <p class="text-zinc-400 text-sm mt-2">of UK jewellery production in Birmingham</p>
      </div>
      <div class="text-center fade-up" style="--i:3;">
        <div class="counter-value" data-count="5" data-suffix="">0</div>
        <p class="text-zinc-400 text-sm mt-2">dedicated business hubs</p>
      </div>
    </div>
  </section>

  <!-- Quick answer -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <div class="quick-answer fade-up">
      <strong>Quick answer:</strong> We run local SEO across Birmingham city centre, Solihull, Edgbaston, Digbeth, the Jewellery Quarter, Sutton Coldfield, and the wider West Midlands. Every area strategy is built from local search data and competitive intelligence — not guesswork.
    </div>
  </section>

  <!-- Intro -->
  <section class="max-w-6xl mx-auto px-4 pb-16">
    <div class="max-w-3xl">
      <p class="text-text-muted text-lg leading-relaxed mb-4 fade-up">Birmingham is not one market. It is a collection of distinct commercial districts, each with its own industry mix, customer base, and competitive intensity. Colmore Business District plays nothing like Digbeth. Sutton Coldfield plays nothing like Solihull. A single uniform strategy fails here.</p>
      <p class="text-text-muted text-lg leading-relaxed fade-up stagger-child" style="--i:1;">We deliver SEO across every major Birmingham district and surrounding West Midlands town. Each engagement starts with local data: what customers in that area search for, who dominates right now, and where the gaps are. From there we build the technical infrastructure, citations, content, and authority signals needed to win visibility in that specific market.</p>
    </div>
  </section>

  <!-- Birmingham City Centre -->
  <section class="bg-brand text-white py-16 md:py-24 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]"
         style="background-image: radial-gradient(circle, rgba(245,158,11,0.5) 1px, transparent 1px); background-size: 24px 24px;"></div>
    <div class="absolute bottom-[-10%] right-[-5%] w-[350px] h-[350px] rounded-full opacity-[0.05] blur-[80px]"
         style="background: radial-gradient(circle, #FBBF24, transparent 70%);"></div>

    <div class="relative max-w-6xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-6 fade-up" style="font-family: var(--font-heading); letter-spacing: -0.03em;">Birmingham City Centre</h2>
      <div class="max-w-3xl">
        <p class="text-zinc-300 leading-relaxed mb-4 fade-up stagger-child" style="--i:1;">The commercial heart of the West Midlands. The most competitive local SEO environment in the region. Professional services firms, retailers, hospitality operators, and tech companies all fight for the same eyeballs. The local pack is heavily contested — especially for solicitors, accountants, and financial advisors.</p>
        <p class="text-zinc-300 leading-relaxed fade-up stagger-child" style="--i:2;">Winning here demands a polished Google Business Profile, airtight NAP consistency, and content that screams Birmingham relevance. Businesses near the Bullring and Grand Central benefit from association with high-authority landmarks in local signals. We combine local and organic SEO for maximum aggregate visibility. Full details on our <a href="/services/" class="text-accent hover:text-accent-light transition-colors font-semibold">SEO services</a> page.</p>
      </div>
    </div>
  </section>

  <!-- Birmingham Districts -->
  <section class="py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-4 fade-up" style="font-family: var(--font-heading); letter-spacing: -0.03em;">Birmingham Districts</h2>
      <p class="text-text-muted max-w-2xl mb-12 fade-up stagger-child" style="--i:1;">Each district has its own competitive profile. We tailor strategy accordingly.</p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="service-card fade-up stagger-child" style="--i:0;">
          <div class="w-10 h-10 bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          </div>
          <h3 class="text-xl font-extrabold mb-3" style="font-family: var(--font-heading);">Edgbaston</h3>
          <p class="text-text-muted text-sm leading-relaxed">One of Birmingham's wealthiest suburbs. Home to Queen Elizabeth Hospital and the Edgbaston Medical Quarter, private schools, and high-end professional services. SEO competition is moderate but climbing — especially for medical, dental, and wellness queries. Residents have high disposable income and specific expectations.</p>
        </div>

        <div class="service-card fade-up stagger-child" style="--i:1;">
          <div class="w-10 h-10 bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
          </div>
          <h3 class="text-xl font-extrabold mb-3" style="font-family: var(--font-heading);">Digbeth</h3>
          <p class="text-text-muted text-sm leading-relaxed">Birmingham's creative and cultural quarter. The Custard Factory and Zellig anchor a district packed with tech startups, creative agencies, and hospitality ventures. SEO here targets younger demographics and emerging brands with thin domain authority. Content-led strategies and social signals carry more weight than in traditional commercial districts.</p>
        </div>

        <div class="service-card fade-up stagger-child" style="--i:2;">
          <div class="w-10 h-10 bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
          </div>
          <h3 class="text-xl font-extrabold mb-3" style="font-family: var(--font-heading);">Jewellery Quarter</h3>
          <p class="text-text-muted text-sm leading-relaxed">Roughly 40% of UK jewellery production happens here. Over 500 trade businesses. SEO competition for jewellery terms is fierce — independents slug it out with national brands. Success requires product-level structured data, image optimisation for visual search, and content proving genuine craft expertise. E-commerce SEO and Google Shopping are essential.</p>
        </div>

        <div class="service-card fade-up stagger-child" style="--i:3;">
          <div class="w-10 h-10 bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="text-xl font-extrabold mb-3" style="font-family: var(--font-heading);">Solihull</h3>
          <p class="text-text-muted text-sm leading-relaxed">Sits where Birmingham's commercial reach meets the affluent commuter belt. Birmingham Business Park hosts major corporates. The town centre sustains strong independent retail and professional services. SEO strategies target both Solihull itself and the broader South Birmingham corridor. Property, automotive, and professional services are the hottest verticals.</p>
        </div>

        <div class="service-card sm:col-span-2 lg:col-span-2 fade-up stagger-child" style="--i:4;">
          <div class="w-10 h-10 bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          </div>
          <h3 class="text-xl font-extrabold mb-3" style="font-family: var(--font-heading);">Sutton Coldfield</h3>
          <p class="text-text-muted text-sm leading-relaxed">A distinct market within Birmingham's search landscape. Royal Town status and suburban character produce search behaviour skewed toward local services, trades, and family businesses. Competition is lower than city centre. That creates opportunity for businesses that move decisively on local SEO. Google Business Profile optimisation and Sutton-specific content deliver strong returns.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Wider West Midlands -->
  <section class="bg-surface py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-4 fade-up" style="font-family: var(--font-heading); letter-spacing: -0.03em;">Wider West Midlands Coverage</h2>
      <p class="text-text-muted max-w-2xl mb-12 fade-up stagger-child" style="--i:1;">We cover the full West Midlands conurbation. Each town has its own search dynamics. We adjust accordingly.</p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {[
          { area: 'Wolverhampton', desc: 'Strong manufacturing and retail base. Digital economy expanding. SEO competition rising for professional services and trades.', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' },
          { area: 'Coventry', desc: 'University city with a growing tech sector. City of Culture legacy keeps tourism and hospitality search demand elevated.', icon: 'M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z' },
          { area: 'Walsall', desc: 'Historic leather goods manufacturing pivoting to modern retail and services. Lower SEO competition means quick wins for proactive businesses.', icon: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6' },
          { area: 'Dudley', desc: 'Tourism draws (Black Country Living Museum, Dudley Zoo) plus established trades and manufacturing chasing local visibility.', icon: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z' },
          { area: 'West Bromwich', desc: 'Growing commercial centre. Rising demand for professional services SEO and local search for retail.', icon: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
          { area: 'Tamworth', desc: 'Commuter town with a solid local business community. Low competitive density. Businesses that commit to SEO early win fast.', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
          { area: 'Lichfield', desc: 'Cathedral city, affluent demographics. Professional services, independent retail, and hospitality compete for a discerning audience.', icon: 'M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z' },
          { area: 'Bromsgrove', desc: 'Straddles Birmingham and Worcestershire. Local businesses gain from targeting both Birmingham-adjacent and Bromsgrove-specific search terms.', icon: 'M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7' },
        ].map((item, i) => (
          <div class="service-card fade-up stagger-child" style={`--i:${i}`}>
            <div class="w-10 h-10 bg-accent/10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}/></svg>
            </div>
            <h3 class="text-lg font-extrabold mb-2" style="font-family: var(--font-heading);">{item.area}</h3>
            <p class="text-text-muted text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Business Hubs -->
  <section class="bg-brand text-white py-16 md:py-24 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]"
         style="background-image: radial-gradient(circle, rgba(245,158,11,0.5) 1px, transparent 1px); background-size: 24px 24px;"></div>
    <div class="absolute top-[-10%] right-[-5%] w-[300px] h-[300px] rounded-full opacity-[0.06] blur-[80px]"
         style="background: radial-gradient(circle, #F59E0B, transparent 70%); animation: aurora-2 10s ease-in-out infinite;"></div>

    <div class="relative max-w-6xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-4 fade-up" style="font-family: var(--font-heading); letter-spacing: -0.03em;">Birmingham Business Hubs</h2>
      <p class="text-zinc-400 max-w-2xl mb-12 fade-up stagger-child" style="--i:1;">Several dedicated hubs within Birmingham demand targeted SEO strategies due to sheer commercial density.</p>

      <div class="grid md:grid-cols-2 gap-4">
        <div class="service-card md:row-span-2 fade-up" style="--i:0; background: rgba(255,255,255,0.03); border-color: rgba(245,158,11,0.2);">
          <div class="w-10 h-10 bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          </div>
          <h3 class="text-xl font-extrabold mb-3 text-white" style="font-family: var(--font-heading);">Colmore Business District</h3>
          <p class="text-zinc-300 leading-relaxed">Birmingham's premier financial and professional services quarter. Major banks, law firms, accountancy practices, corporate HQs. SEO competition here is the fiercest in the region. You need serious domain authority, clear E-E-A-T signals, and content that proves expertise — or you do not rank.</p>
        </div>

        <div class="service-card fade-up stagger-child" style="--i:1; background: rgba(255,255,255,0.03); border-color: rgba(245,158,11,0.2);">
          <h3 class="text-lg font-extrabold mb-2 text-white" style="font-family: var(--font-heading);">Brindleyplace</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">Mixed commercial and leisure development. Strong brand recognition in local search. Hospitality operators contest dining and leisure terms. Professional services firms target corporate keywords. The area's identity works for you if you optimise around it.</p>
        </div>

        <div class="service-card fade-up stagger-child" style="--i:2; background: rgba(255,255,255,0.03); border-color: rgba(245,158,11,0.2);">
          <h3 class="text-lg font-extrabold mb-2 text-white" style="font-family: var(--font-heading);">Birmingham Business Park</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">One of the UK's largest business parks, based in Solihull. Tech, logistics, and professional services tenants. SEO often targets national terms, but a local layer captures substantial Solihull and South Birmingham demand.</p>
        </div>
      </div>

      <div class="grid sm:grid-cols-2 gap-4 mt-4">
        <div class="service-card fade-up stagger-child" style="--i:3; background: rgba(255,255,255,0.03); border-color: rgba(245,158,11,0.2);">
          <h3 class="text-lg font-extrabold mb-2 text-white" style="font-family: var(--font-heading);">Innovation Birmingham Campus</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">The city's primary tech and innovation hub. Startups, scale-ups, R&D operations. SEO centres on SaaS keywords, B2B lead generation, and thought leadership content that builds authority in emerging sectors.</p>
        </div>

        <div class="service-card fade-up stagger-child" style="--i:4; background: rgba(255,255,255,0.03); border-color: rgba(245,158,11,0.2);">
          <h3 class="text-lg font-extrabold mb-2 text-white" style="font-family: var(--font-heading);">Custard Factory</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">Digbeth's creative hub. Independent businesses, agencies, makers. SEO here leans on brand building, content marketing, and social visibility alongside traditional search tactics.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Local SEO Varies -->
  <section class="py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-8 fade-up" style="font-family: var(--font-heading); letter-spacing: -0.03em;">Why Local SEO Varies by Area</h2>

      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <div class="fade-up stagger-child" style="--i:1;">
          <p class="text-text-muted text-lg leading-relaxed mb-4">Google's local algorithm weighs three things: proximity (how close the searcher is to your business), relevance (how well your listing matches the query), and prominence (how established and authoritative you are). These factors play out differently in every Birmingham area.</p>
          <p class="text-text-muted text-lg leading-relaxed mb-4">In dense zones like Colmore Business District, proximity matters less — dozens of similar businesses cluster together. Prominence and relevance decide winners. Stronger reviews, more authoritative citations, better content. In suburban areas like Sutton Coldfield, proximity carries more weight. Solid foundational SEO lets you dominate your patch.</p>
          <p class="text-text-muted text-lg leading-relaxed">We analyse these dynamics for every area we serve. Running identical tactics in Wolverhampton and the Jewellery Quarter would waste money — the competition, the customer, and the search intent are materially different. That is why our <a href="/services/" class="text-accent hover:text-accent-dark transition-colors font-semibold">SEO services</a> always start with data from your specific area.</p>
        </div>

        <div class="space-y-4 fade-up stagger-child" style="--i:2;">
          <div class="stat-card">
            <div class="flex items-center gap-3 mb-2">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
              <h3 class="font-extrabold" style="font-family: var(--font-heading);">Proximity</h3>
            </div>
            <p class="text-text-muted text-sm">How close the searcher is to your business. Dominant in suburban areas like Sutton Coldfield.</p>
          </div>
          <div class="stat-card">
            <div class="flex items-center gap-3 mb-2">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <h3 class="font-extrabold" style="font-family: var(--font-heading);">Relevance</h3>
            </div>
            <p class="text-text-muted text-sm">How well your listing matches the query. Critical in dense commercial districts.</p>
          </div>
          <div class="stat-card">
            <div class="flex items-center gap-3 mb-2">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
              <h3 class="font-extrabold" style="font-family: var(--font-heading);">Prominence</h3>
            </div>
            <p class="text-text-muted text-sm">How established and authoritative you are. The deciding factor in Colmore Business District.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <div class="cta-box">
    <h2 style="color: white; margin-top: 0; font-family: var(--font-heading); font-size: 2rem; letter-spacing: -0.03em;" class="fade-up">Own Your Local Search</h2>
    <p class="fade-up stagger-child" style="--i:1;">City centre, suburbs, or wider West Midlands — we build the local SEO strategy that puts you in front of customers searching in your market.</p>
    <a href="/contact/" class="fade-up stagger-child" style="--i:2;">Talk to Us</a>
