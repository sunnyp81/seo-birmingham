  <!-- FAQ -->
  <section class="py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-8 fade-up" style="font-family: var(--font-heading); letter-spacing: -0.03em;">Frequently Asked Questions</h2>

      <div class="faq-section">
        {faqData.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <div class="faq-answer">
              <p>{faq.answer}</p>
