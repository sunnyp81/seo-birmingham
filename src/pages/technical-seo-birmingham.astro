---
import Base from '../layouts/Base.astro';

const faqs = [
  {
    q: 'What does technical SEO involve for Birmingham businesses?',
    a: 'Technical SEO fixes the infrastructure that decides whether search engines can crawl, index, and rank your site. Broken foundations mean lost rankings. We sort that out for Birmingham businesses across manufacturing, professional services, and retail.',
  },
  {
    q: 'How long does a technical SEO audit take?',
    a: 'Five to ten working days. A 20-page brochure site is faster. A large e-commerce platform with thousands of product pages takes longer. We scope it on the call.',
  },
  {
    q: 'What does technical SEO cost in Birmingham?',
    a: 'Audits start at £500. Ongoing technical retainers for Birmingham organisations run £500 to £2,000 per month, depending on site complexity and how much needs fixing.',
  },
  {
    q: 'Does technical SEO affect AI search visibility?',
    a: 'Yes. Google AI Overviews, ChatGPT, and Perplexity all depend on well-structured, fast pages with clean markup. If your site is not machine-readable, AI will not cite it.',
  },
  {
    q: 'What are Core Web Vitals and why do they matter?',
    a: 'Core Web Vitals are Google\'s page experience benchmarks. LCP measures loading speed. INP measures responsiveness. CLS measures visual stability. They are a confirmed ranking factor. Fail them and your Birmingham competitors overtake you.',
  },
  {
    q: 'Do WordPress sites need technical SEO?',
    a: 'Almost always. Bloated plugins kill page speed. Tag and category archives create duplicate content. Mobile rendering breaks. Structured data is missing. We find and fix every one of these problems.',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Technical SEO Birmingham',
  description: 'Technical SEO services for Birmingham businesses including site audits, Core Web Vitals optimisation, crawlability fixes, and structured data implementation.',
  provider: {
    '@type': 'Organization',
    name: 'SEO Birmingham',
    url: 'https://seo-birmingham.uk',
    sameAs: [],
    areaServed: {
      '@type': 'City',
      name: 'Birmingham',
      containedInPlace: { '@type': 'AdministrativeArea', name: 'West Midlands' },
    },
  },
  serviceType: 'Technical SEO',
  areaServed: {
    '@type': 'City',
    name: 'Birmingham',
    containedInPlace: { '@type': 'AdministrativeArea', name: 'West Midlands' },
  },
  offers: {
    '@type': 'Offer',
    price: '500',
    priceCurrency: 'GBP',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '500',
      priceCurrency: 'GBP',
      unitText: 'per audit',
      description: 'Starting from £500 per technical SEO audit',
    },
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Technical SEO Birmingham | SEO Birmingham"
  description="Technical SEO for Birmingham businesses. Site speed, Core Web Vitals, crawlability, structured data, and mobile-first audits from £500. We find the problems. We fix them."
  schema={[serviceSchema, faqSchema]}
  ogType="website"
>

  <!-- Hero -->
  <section class="relative bg-brand text-white overflow-hidden min-h-[60vh] flex items-center">
    <div class="absolute top-[-20%] left-[-10%] w-[500px] h-[500px] rounded-full opacity-[0.07] blur-[100px]"
         style="background: radial-gradient(circle, #F59E0B, transparent 70%); animation: aurora-1 8s ease-in-out infinite;"></div>
    <div class="absolute bottom-[-15%] right-[-5%] w-[400px] h-[400px] rounded-full opacity-[0.05] blur-[80px]"
         style="background: radial-gradient(circle, #FBBF24, transparent 70%); animation: aurora-2 12s ease-in-out infinite;"></div>
    <div class="absolute inset-0 opacity-[0.03]"
         style="background-image: radial-gradient(circle, rgba(245,158,11,0.5) 1px, transparent 1px); background-size: 32px 32px;"></div>

    <div class="relative max-w-6xl mx-auto px-4 py-24 md:py-32 w-full">
      <p class="text-accent font-bold text-sm uppercase tracking-widest mb-4 fade-up" style="font-family: var(--font-heading);">SEO Birmingham</p>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-[1.05] mb-6 fade-up" style="--i:1; font-family: var(--font-heading); letter-spacing: -0.04em;">
        Technical SEO<br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-accent-light">Birmingham</span>
      </h1>
      <p class="text-zinc-400 text-lg md:text-xl max-w-2xl mb-8 fade-up stagger-child" style="--i:2;">
        Your site is slow. We fix that. Your pages are not indexed. We fix that too. Technical SEO is the foundation everything else sits on. Without it, your content and backlinks count for nothing. We deliver systematic technical SEO for Birmingham businesses across Google, Bing, and AI search platforms.
      </p>
      <div class="flex flex-wrap gap-4 fade-up stagger-child" style="--i:3;">
        <a href="/free-seo-audit-birmingham/" class="btn-shimmer">Get the Audit</a>
        <a href="/seo-pricing-birmingham/" class="inline-block border-2 border-zinc-600 text-white px-6 py-3 font-bold text-sm uppercase tracking-wider hover:border-accent hover:text-accent transition-colors duration-200" style="font-family: var(--font-heading);">View Pricing</a>
      </div>
    </div>
  </section>

  <!-- Stats row -->
  <section class="bg-brand border-y border-zinc-800">
    <div class="max-w-6xl mx-auto px-4 py-10 grid grid-cols-2 md:grid-cols-4 gap-6">
      <div class="text-center fade-up" style="--i:0;">
        <div class="counter-value" data-count="2.5" data-suffix="s">0s</div>
        <p class="text-zinc-400 text-sm mt-2">LCP target threshold</p>
      </div>
      <div class="text-center fade-up" style="--i:1;">
        <div class="counter-value" data-count="500" data-suffix="+">0</div>
        <p class="text-zinc-400 text-sm mt-2">audits from (GBP)</p>
      </div>
      <div class="text-center fade-up" style="--i:2;">
        <div class="counter-value" data-count="5" data-suffix="">0</div>
        <p class="text-zinc-400 text-sm mt-2">schema types we implement</p>
      </div>
      <div class="text-center fade-up" style="--i:3;">
        <div class="counter-value" data-count="100" data-suffix="%">0%</div>
        <p class="text-zinc-400 text-sm mt-2">mobile-first approach</p>
      </div>
    </div>
  </section>

  <!-- Quick answer -->
  <section class="max-w-4xl mx-auto px-4 py-16">
    <div class="quick-answer fade-up">
      <strong>Quick Answer:</strong> Technical SEO removes the invisible barriers that stop search engines indexing your site. For Birmingham businesses, that means faster pages, clean architecture, validated structured data, and mobile-first design that turns local searchers into customers. Audits start from <a href="/seo-pricing-birmingham/">£500</a>. <a href="/free-seo-audit-birmingham/">Get the audit</a>.
    </div>
  </section>

  <!-- What Technical SEO Does -->
  <section class="max-w-4xl mx-auto px-4 pb-16">
    <div class="prose">
      <h2 class="fade-up">What Technical SEO Does for Birmingham Businesses</h2>

      <div class="fade-up">
        <p>Technical SEO deals with infrastructure. Server response times. Crawl efficiency. Indexation control. Structured data integrity. Security protocols. Get these right and search engines process your site without friction. Get them wrong and you lose ground to competitors who did not.</p>

        <p>Birmingham is one of the most competitive commercial markets outside London. Whether you operate from the Colmore Business District, trade from the <a href="/areas/">Jewellery Quarter</a>, or serve event clients near the NEC, your website competes against hundreds of local rivals for the same search queries. Technical SEO stops you losing that competition on infrastructure alone.</p>

        <p>We see the same problems on Birmingham business websites every week. Slow server response times from budget hosting. Orphaned pages invisible to crawlers. Duplicate content across product variants. Missing or broken structured data. Each one costs you rankings and revenue.</p>
      </div>
    </div>
  </section>

  <!-- Core Web Vitals -->
  <section class="bg-brand text-white py-16 md:py-24 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]"
         style="background-image: radial-gradient(circle, rgba(245,158,11,0.5) 1px, transparent 1px); background-size: 24px 24px;"></div>
    <div class="absolute top-[-10%] right-[-5%] w-[300px] h-[300px] rounded-full opacity-[0.06] blur-[80px]"
         style="background: radial-gradient(circle, #F59E0B, transparent 70%); animation: aurora-2 10s ease-in-out infinite;"></div>

    <div class="relative max-w-6xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-4 fade-up" style="font-family: var(--font-heading); letter-spacing: -0.03em;">Core Web Vitals Optimisation</h2>
      <p class="text-zinc-400 max-w-2xl mb-12 fade-up stagger-child" style="--i:1;">Core Web Vitals are Google's page experience benchmarks. They affect rankings directly. They shape how users perceive your site in the first seconds of loading. Fail them and you pay the price.</p>

      <div class="grid md:grid-cols-3 gap-4">
        <div class="service-card fade-up stagger-child" style="--i:0; background: rgba(24,24,27,0.6); border-color: rgba(63,63,70,0.5);">
          <div class="w-10 h-10 bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="text-xl font-extrabold mb-3 text-white" style="font-family: var(--font-heading);">Largest Contentful Paint (LCP)</h3>
          <p class="text-zinc-400 leading-relaxed">LCP measures how quickly your main content becomes visible. Google wants this under 2.5 seconds. Corporate websites in the Colmore Business District routinely fail LCP because of unoptimised hero images and render-blocking scripts from legacy CMS platforms. Custard Factory startups on modern frameworks do better but still hit delays from third-party widget loading. We strip the bloat and hit the target.</p>
        </div>

        <div class="service-card fade-up stagger-child" style="--i:1; background: rgba(24,24,27,0.6); border-color: rgba(63,63,70,0.5);">
          <div class="w-10 h-10 bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"/></svg>
          </div>
          <h3 class="text-xl font-extrabold mb-3 text-white" style="font-family: var(--font-heading);">Interaction to Next Paint (INP)</h3>
          <p class="text-zinc-400 leading-relaxed">INP measures how fast your site responds when someone clicks, taps, or presses a key. E-commerce sites serving Birmingham's Bullring and Grand Central struggle here. Heavy JavaScript from product filtering, live stock checkers, and payment integrations drags response times down. We cut what is not needed and optimise what is.</p>
        </div>

        <div class="service-card fade-up stagger-child" style="--i:2; background: rgba(24,24,27,0.6); border-color: rgba(63,63,70,0.5);">
          <div class="w-10 h-10 bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm0 8a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zm10 0a1 1 0 011-1h4a1 1 0 011 1v6a1 1 0 01-1 1h-4a1 1 0 01-1-1v-6z"/></svg>
          </div>
          <h3 class="text-xl font-extrabold mb-3 text-white" style="font-family: var(--font-heading);">Cumulative Layout Shift (CLS)</h3>
          <p class="text-zinc-400 leading-relaxed">CLS tracks unexpected visual movement during page load. Elements shift. Users click the wrong thing. They leave. This is particularly damaging for service businesses where layout instability kills conversions before you even get a chance.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Crawlability and Indexation -->
  <section class="py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-4 fade-up" style="font-family: var(--font-heading); letter-spacing: -0.03em;">Crawlability and Indexation</h2>
      <p class="text-text-muted max-w-3xl mb-12 fade-up stagger-child" style="--i:1;">If search engines cannot crawl your site efficiently, your pages will not appear in results. Full stop. Content quality is irrelevant if Google never sees it. Crawlability issues are among the most frequent problems we diagnose in <a href="/seo-audit-birmingham/" class="text-accent hover:text-accent-light transition-colors">Birmingham SEO audits</a>.</p>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="fade-up" style="--i:2;">
          <h3 class="text-xl font-extrabold mb-4" style="font-family: var(--font-heading);">Common Crawl Issues in Birmingham E-Commerce</h3>
          <p class="text-text-muted mb-6">Birmingham has a thriving retail and e-commerce sector. Independent Jewellery Quarter retailers selling online. Bullring brands expanding into direct-to-consumer channels. These sites suffer from predictable problems:</p>

          <div class="space-y-3">
            {[
              'Faceted navigation generating thousands of duplicate URLs that waste crawl budget',
              'Session IDs appended to URLs, creating infinite crawl loops',
              'Orphaned product pages from discontinued stock still sitting in the index',
              'Pagination without proper rel=next/prev or canonical signals',
              'Broken internal links from site redesigns or platform migrations',
            ].map((item, i) => (
              <div class="flex gap-3 items-start fade-up stagger-child" style={`--i:${i + 3}`}>
                <div class="w-6 h-6 bg-accent/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-3 h-3 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"/></svg>
                </div>
                <p class="text-text-muted text-sm leading-relaxed">{item}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="service-card fade-up stagger-child" style="--i:3;">
          <div class="w-10 h-10 bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3 class="text-xl font-extrabold mb-3" style="font-family: var(--font-heading);">Indexation Control</h3>
          <p class="text-text-muted leading-relaxed">Not every page deserves to be indexed. Admin pages, staging environments, thin filter pages, internal search results, they all dilute your quality signals. We implement precise indexation controls using robots.txt directives, meta robots tags, and canonical URLs. Google indexes only the pages that deserve to rank. Nothing else.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Structured Data -->
  <section class="bg-surface py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-4 fade-up" style="font-family: var(--font-heading); letter-spacing: -0.03em;">Structured Data and Schema Markup</h2>
      <p class="text-text-muted max-w-3xl mb-12 fade-up stagger-child" style="--i:1;">Structured data tells search engines exactly what your content represents. Correct schema markup triggers rich results. Rich results increase click-through rates. Higher click-through rates mean more traffic from the same rankings.</p>

      <h3 class="text-xl font-extrabold mb-6 fade-up" style="font-family: var(--font-heading);">Essential Schema Types for Birmingham Companies</h3>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
        {[
          { type: 'LocalBusiness', best: 'Any Birmingham business with a physical location', result: 'Knowledge panel, local pack' },
          { type: 'Product', best: 'Jewellery Quarter retailers, Bullring e-commerce', result: 'Price, availability, reviews in SERPs' },
          { type: 'Service', best: 'Professional services, Colmore consultancies', result: 'Service details in knowledge panel' },
          { type: 'FAQPage', best: 'Any page with frequently asked questions', result: 'Expandable FAQ in search results' },
          { type: 'Event', best: 'NEC exhibitions, Digbeth venue operators', result: 'Event listings with dates and tickets' },
        ].map((item, i) => (
          <div class="service-card fade-up stagger-child" style={`--i:${i}`}>
            <h4 class="text-accent font-extrabold text-lg mb-2" style="font-family: var(--font-heading);">{item.type}</h4>
            <p class="text-text-muted text-sm mb-2"><strong class="text-text">Best for:</strong> {item.best}</p>
            <p class="text-text-muted text-sm"><strong class="text-text">Rich result:</strong> {item.result}</p>
          </div>
        ))}
      </div>

      <div class="prose fade-up">
        <p>We implement all structured data as JSON-LD inline on each page, following Google's current specifications. Every schema block is validated against Schema.org before deployment. No shortcuts.</p>
      </div>
    </div>
  </section>

  <!-- Site Architecture -->
  <section class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4">
      <div class="prose">
        <h2 class="fade-up">Site Architecture for Multi-Location Businesses</h2>

        <div class="fade-up">
          <p>Multiple locations need architecture that works for both users and search engines. A solicitor with offices on Colmore Row, in Solihull, and in Sutton Coldfield needs dedicated location pages with unique content. Not templated copies with the town name swapped out.</p>

          <p>Effective multi-location architecture means a clear URL hierarchy (/areas/solihull/, /areas/sutton-coldfield/), internal linking between location pages and <a href="/services/">service pages</a>, and locally relevant content that proves genuine presence in each area. This structure also supports <a href="/ai-search-optimisation-birmingham/">AI search optimisation</a> by giving machine learning models clear geographic context.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mobile-First + HTTPS - dark section -->
  <section class="bg-brand text-white py-16 md:py-24 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]"
         style="background-image: radial-gradient(circle, rgba(245,158,11,0.5) 1px, transparent 1px); background-size: 24px 24px;"></div>

    <div class="relative max-w-6xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-8">
        <div class="service-card fade-up" style="--i:0; background: rgba(24,24,27,0.6); border-color: rgba(63,63,70,0.5);">
          <div class="w-10 h-10 bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="text-xl font-extrabold mb-3 text-white" style="font-family: var(--font-heading);">Mobile-First Indexing for Local Search</h3>
          <p class="text-zinc-400 leading-relaxed mb-4">Google uses mobile-first indexing. It crawls and ranks the mobile version of your site. For Birmingham local search, this matters because most "near me" queries come from mobile devices used by people physically in the city.</p>
          <p class="text-zinc-400 leading-relaxed mb-4">Someone on New Street searching "solicitor near me" expects your site to load instantly, show a phone number prominently, and display a Birmingham address clearly. If your mobile site loads slowly, presents tiny tap targets, or buries contact information behind navigation layers, that potential client goes to a competitor. Every time.</p>
          <p class="text-zinc-400 leading-relaxed">We test every client site on real devices. Not just Chrome DevTools emulation. Real-world performance on mid-range Android devices over 4G connections is the benchmark that matters for Birmingham local searchers.</p>
        </div>

        <div class="service-card fade-up stagger-child" style="--i:1; background: rgba(24,24,27,0.6); border-color: rgba(63,63,70,0.5);">
          <div class="w-10 h-10 bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          </div>
          <h3 class="text-xl font-extrabold mb-3 text-white" style="font-family: var(--font-heading);">HTTPS and Security Protocols</h3>
          <p class="text-zinc-400 leading-relaxed mb-4">HTTPS is a baseline ranking signal. Every page must load over a valid SSL/TLS certificate with no mixed content warnings. Beyond rankings, HTTPS protects customer data and builds trust. That matters for e-commerce sites and service businesses handling enquiry forms or payment details.</p>
          <p class="text-zinc-400 leading-relaxed">Common security problems we find: expired certificates, mixed content from legacy HTTP image URLs, insecure form submissions, and missing security headers like Content-Security-Policy and X-Frame-Options. All fixable. All worth fixing.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- International SEO -->
  <section class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4">
      <div class="prose">
        <h2 class="fade-up">International SEO for Birmingham Manufacturers</h2>

        <div class="fade-up">
          <p>Birmingham has a substantial export-oriented manufacturing sector. Precision engineering in Aston. Automotive components across the wider West Midlands. If you sell internationally, your technical SEO needs to handle multiple languages and regional targeting correctly.</p>

          <p>That means hreflang implementation to signal language and regional variants to Google, country-specific domain or subdirectory strategies, currency and unit localisation, and server-side content negotiation. Get hreflang wrong and the German version of your product page outranks the English version for UK searchers. We make sure that does not happen.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- AI Search Visibility -->
  <section class="bg-surface py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div class="fade-up">
          <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-6" style="font-family: var(--font-heading); letter-spacing: -0.03em;">Technical SEO and AI Search Visibility</h2>
          <p class="text-text-muted leading-relaxed mb-4">AI search platforms crawl and cite well-structured websites. Google AI Overviews, ChatGPT, Perplexity, they all favour the same foundations that traditional search engines reward.</p>
          <p class="text-text-muted leading-relaxed">Clean HTML semantics. Comprehensive schema markup. Fast page speeds. Logical site architecture. These are what make your site visible to AI. Sites with poor technical health get crawled less by AI training pipelines and cited less in AI-generated responses. Our <a href="/ai-search-optimisation-birmingham/" class="text-accent hover:text-accent-light transition-colors">AI search optimisation</a> page covers this in detail.</p>
        </div>

        <div class="grid grid-cols-2 gap-4 fade-up stagger-child" style="--i:1;">
          {[
            { label: 'Clean HTML', icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4' },
            { label: 'Schema Markup', icon: 'M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z' },
            { label: 'Fast Pages', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
            { label: 'Clear Architecture', icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10' },
          ].map((item, i) => (
            <div class="stat-card text-center fade-up stagger-child" style={`--i:${i + 2}`}>
              <div class="w-10 h-10 bg-accent/10 flex items-center justify-center mx-auto mb-3">
