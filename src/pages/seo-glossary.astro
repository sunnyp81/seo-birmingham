---
import Base from '../layouts/Base.astro';

const terms = [
  { term: 'Algorithm', letter: 'A', def: 'A set of rules a search engine uses to rank web pages. Google updates its algorithm thousands of times a year. Each update can shift where your Birmingham business appears for local searches.' },
  { term: 'Alt Text', letter: 'A', def: 'Descriptive text added to an image so search engines and screen readers understand what it shows. Writing "plumber fixing boiler in Edgbaston kitchen" beats "IMG_4032.jpg" every time.' },
  { term: 'Anchor Text', letter: 'A', def: 'The clickable words inside a hyperlink. Search engines use anchor text to understand what the linked page is about. Descriptive anchors like "Birmingham SEO audit" pass more context than "click here".' },
  { term: 'Authority', letter: 'A', def: 'A measure of how trustworthy and credible a website or page is in the eyes of search engines. Authority builds through quality backlinks, consistent content, and real-world reputation. A Birmingham solicitor cited by the Law Society carries more authority than a brand-new blog.' },
  { term: 'AI Overview', letter: 'A', def: 'Google\'s AI-generated summary that appears above traditional search results. AI Overviews pull from multiple sources to answer queries directly. Getting cited inside one requires <a href="/ai-search-optimisation-birmingham/">structured content and entity clarity</a>.' },
  { term: 'AEO (Answer Engine Optimisation)', letter: 'A', def: 'The practice of optimising content to be selected as a direct answer by AI search engines like ChatGPT, Perplexity, and Google AI Overviews. AEO focuses on clear, factual statements rather than keyword repetition. <a href="/ai-search-optimisation-birmingham/">Learn more about AEO</a>.' },

  { term: 'Backlink', letter: 'B', def: 'A link from another website pointing to yours. Search engines treat backlinks as votes of confidence. A link from Birmingham City Council or a West Midlands news outlet carries real weight for local rankings.' },
  { term: 'Black Hat SEO', letter: 'B', def: 'SEO tactics that violate search engine guidelines to manipulate rankings. Includes keyword stuffing, cloaking, and buying links. Short-term gains, long-term penalties. We do not use them.' },
  { term: 'Bounce Rate', letter: 'B', def: 'The percentage of visitors who leave your site after viewing only one page. A high bounce rate on a Birmingham service page often signals slow load times, poor mobile experience, or content that does not match what the searcher wanted.' },
  { term: 'Breadcrumb', letter: 'B', def: 'A navigation trail showing where a page sits in your site hierarchy (e.g., Home > Services > Technical SEO). Breadcrumbs help users navigate and give search engines extra structure signals. They often appear in search results too.' },
  { term: 'Brand SERP', letter: 'B', def: 'The search results page that appears when someone searches your brand name. A clean Brand SERP shows your website, Google Business Profile, social accounts, and reviews. A messy one shows competitors or outdated information.' },
  { term: 'Bing Webmaster Tools', letter: 'B', def: 'Microsoft\'s free platform for monitoring your site\'s performance in Bing search. Often overlooked, but Bing powers AI search in Copilot and ChatGPT. Ignoring Bing means ignoring a growing share of AI-driven traffic.' },

  { term: 'Canonical Tag', letter: 'C', def: 'An HTML element that tells search engines which version of a page is the "official" one. Prevents duplicate content issues when the same page exists at multiple URLs. Essential for e-commerce sites with filtered product views.' },
  { term: 'Citation', letter: 'C', def: 'A mention of your business name, address, and phone number on another website. Citations on directories like Yell, Thomson Local, and industry-specific platforms help Birmingham businesses rank in the Local Pack.' },
  { term: 'Click-Through Rate (CTR)', letter: 'C', def: 'The percentage of people who see your listing in search results and actually click it. A compelling title tag and meta description lift CTR. Low CTR despite good rankings means your snippet needs work.' },
  { term: 'Content Cluster', letter: 'C', def: 'A group of related pages organised around a central pillar topic, linked together with internal links. Content clusters signal topical depth to search engines. A Birmingham law firm might cluster pages around "employment law" as the pillar.' },
  { term: 'Core Web Vitals', letter: 'C', def: 'Google\'s three performance metrics: LCP (loading), INP (interactivity), and CLS (visual stability). They are a confirmed ranking factor. Most Birmingham business websites fail at least one. <a href="/technical-seo-birmingham/">We fix that</a>.' },
  { term: 'Crawl Budget', letter: 'C', def: 'The number of pages a search engine will crawl on your site within a given timeframe. Large sites with thousands of pages need to manage crawl budget carefully so important pages get indexed and junk pages do not waste it.' },
  { term: 'Crawlability', letter: 'C', def: 'Whether search engine bots can access and read your web pages. Blocked by robots.txt, broken internal links, or JavaScript rendering issues. If a page cannot be crawled, it cannot be indexed or ranked.' },
  { term: 'Conversion Rate', letter: 'C', def: 'The percentage of website visitors who complete a desired action, filling in a contact form, calling your number, or making a purchase. SEO drives traffic. Conversion rate determines whether that traffic generates revenue.' },

  { term: 'Domain Authority', letter: 'D', def: 'A score (0-100) created by Moz that predicts how likely a domain is to rank. Not a Google metric, but a useful benchmark. New Birmingham business websites typically start around 10-15 and build from there.' },
  { term: 'Domain Rating', letter: 'D', def: 'Ahrefs\' version of domain strength, scored 0-100 based on backlink profile. Like Domain Authority, it is a third-party metric, not used by Google directly. Useful for competitive comparison.' },
  { term: 'Duplicate Content', letter: 'D', def: 'Identical or very similar content appearing on multiple URLs. Confuses search engines about which page to rank. Common culprits: printer-friendly pages, URL parameters, and HTTP/HTTPS variants.' },
  { term: 'Disavow', letter: 'D', def: 'A tool in Google Search Console that tells Google to ignore specific backlinks pointing to your site. Used when spammy or toxic links are harming your rankings and you cannot get them removed manually.' },
  { term: 'Deep Link', letter: 'D', def: 'A link that points to a specific internal page rather than the homepage. Deep links distribute link equity across your site and help search engines discover important pages buried in your architecture.' },

  { term: 'E-E-A-T', letter: 'E', def: 'Experience, Expertise, Authoritativeness, Trustworthiness. Google\'s quality framework for evaluating content. Critical for YMYL topics like health and finance. Demonstrating real-world experience in Birmingham\'s market matters more than generic advice.' },
  { term: 'Entity', letter: 'E', def: 'A distinct, identifiable thing (a person, business, place, or concept) that search engines recognise. "SEO Birmingham" is an entity. Structured data and consistent references across the web help search engines understand your entity.' },
  { term: 'External Link', letter: 'E', def: 'A link from your website pointing to a different domain. Linking to authoritative, relevant sources signals trust and adds context. Do not hoard link equity, strategic external links improve your content\'s credibility.' },

  { term: 'Featured Snippet', letter: 'F', def: 'A highlighted answer box that appears at the top of Google search results (position zero). Winning a featured snippet means structuring your content as a direct, concise answer to a specific question.' },
  { term: 'Fetch and Render', letter: 'F', def: 'A Google Search Console tool (now URL Inspection) that shows how Googlebot sees your page. Reveals JavaScript rendering issues, blocked resources, and layout problems invisible to normal browsing.' },
  { term: 'First Input Delay (FID)', letter: 'F', def: 'A Core Web Vital that measured how quickly a page responds to user interaction. Replaced by INP (Interaction to Next Paint) in March 2024. FID measured only the first interaction; INP measures all of them.' },

  { term: 'Google Business Profile', letter: 'G', def: 'Your free business listing on Google Maps and local search. For Birmingham businesses, an optimised GBP is essential for appearing in the Local Pack. Keep NAP details accurate, add photos, and respond to reviews.' },
  { term: 'Google Search Console', letter: 'G', def: 'Google\'s free tool for monitoring your site\'s search performance. Shows which queries drive impressions and clicks, flags indexing errors, and reports Core Web Vitals issues. Every Birmingham business should have it connected. <a href="/free-seo-audit-birmingham/">Request a free audit</a>.' },
  { term: 'Google Analytics', letter: 'G', def: 'Google\'s web analytics platform (currently GA4). Tracks visitor behaviour: where they come from, which pages they view, how long they stay, and whether they convert. Essential for measuring SEO ROI.' },
  { term: 'GEO (Generative Engine Optimisation)', letter: 'G', def: 'Optimising content to appear in AI-generated search results across platforms like ChatGPT, Perplexity, and Google AI Overviews. Overlaps with AEO but covers the full generative AI search landscape. <a href="/ai-search-optimisation-birmingham/">Our approach to GEO</a>.' },
  { term: 'Google Penalty', letter: 'G', def: 'A ranking demotion caused by violating Google\'s guidelines (manual action) or by an algorithm update hitting your site. Recovery requires identifying the cause, fixing it, and submitting a reconsideration request.' },

  { term: 'Header Tags', letter: 'H', def: 'HTML elements (H1 through H6) that structure your page content into a hierarchy. One H1 per page summarising the main topic. H2s and H3s break content into scannable sections. Search engines use them to understand page structure.' },
  { term: 'Hreflang', letter: 'H', def: 'An HTML attribute that tells search engines which language and region a page targets. Essential for businesses serving multiple countries or languages. A Birmingham company with a German-language site needs hreflang to avoid cannibalisation.' },
  { term: 'HTTP Status Codes', letter: 'H', def: 'Server responses that tell browsers and crawlers what happened with a request. 200 means success. 301 is a permanent redirect. 404 means page not found. 500 is a server error. <a href="/technical-seo-birmingham/">Technical SEO</a> keeps these clean.' },
  { term: 'HTTPS', letter: 'H', def: 'The secure version of HTTP, encrypting data between browser and server. Google confirmed HTTPS as a ranking signal in 2014. Any Birmingham business still on HTTP is losing trust signals and potentially rankings.' },

  { term: 'Impressions', letter: 'I', def: 'The number of times your page appeared in search results, whether or not anyone clicked. High impressions with low clicks means your listing is visible but not compelling enough to earn the click.' },
  { term: 'Index', letter: 'I', def: 'Google\'s database of all web pages it has crawled and stored. If your page is not in the index, it cannot appear in search results. Check indexation status in Google Search Console.' },
  { term: 'Internal Link', letter: 'I', def: 'A link from one page on your site to another page on the same site. Internal links distribute authority, establish hierarchy, and help search engines discover content. Most sites underuse them.' },
  { term: 'INP (Interaction to Next Paint)', letter: 'I', def: 'A Core Web Vital measuring how quickly your page responds to any user interaction, clicks, taps, keyboard input. Replaced FID in March 2024. Google considers anything under 200ms "good". Heavy JavaScript frameworks often fail this.' },
  { term: 'Indexability', letter: 'I', def: 'Whether a page is eligible to be added to a search engine\'s index. Blocked by noindex tags, canonical tags pointing elsewhere, or robots.txt rules. A page can be crawlable but not indexable.' },

  { term: 'JavaScript SEO', letter: 'J', def: 'The practice of ensuring search engines can crawl, render, and index content generated by JavaScript. Many modern websites rely on JavaScript to display content. If Googlebot cannot render it, the content effectively does not exist.' },
  { term: 'JSON-LD', letter: 'J', def: 'A structured data format that embeds schema markup as a script block in your HTML. Google\'s preferred method for structured data. Cleaner than microdata because it separates the data from the visible content.' },

  { term: 'Keyword', letter: 'K', def: 'A word or phrase that users type into search engines. "SEO Birmingham" is a keyword. Effective SEO targets keywords your customers actually use, not the ones you assume they use.' },
  { term: 'Keyword Cannibalisation', letter: 'K', def: 'When multiple pages on your site compete for the same keyword, splitting authority and confusing search engines about which page to rank. Common on Birmingham business sites with separate location pages targeting overlapping terms.' },
  { term: 'Keyword Density', letter: 'K', def: 'The percentage of times a keyword appears relative to total word count. An outdated metric. Modern search engines understand context and synonyms. Writing naturally beats stuffing a keyword into every sentence.' },
  { term: 'Keyword Difficulty', letter: 'K', def: 'A score estimating how hard it is to rank for a specific keyword. Measured by tools like Ahrefs and Semrush based on the strength of currently ranking pages. Higher difficulty means you need stronger content and more backlinks.' },
  { term: 'Knowledge Panel', letter: 'K', def: 'An information box Google displays on the right side of search results for recognised entities. Businesses, people, and organisations can earn Knowledge Panels through structured data, Wikipedia entries, and consistent entity signals.' },

  { term: 'Landing Page', letter: 'L', def: 'The page a visitor arrives on after clicking a link or ad. In SEO, every indexed page is a potential landing page. Each one should have a clear purpose, strong relevance to the search query, and an obvious next step.' },
  { term: 'LCP (Largest Contentful Paint)', letter: 'L', def: 'A Core Web Vital measuring how long the largest visible element (usually a hero image or heading) takes to load. Google considers under 2.5 seconds "good". Slow hosting and unoptimised images are the usual culprits.' },
  { term: 'Link Building', letter: 'L', def: 'The process of earning backlinks from other websites to improve your site\'s authority. Quality matters more than quantity. One link from a respected Birmingham publication outweighs a hundred from spam directories.' },
  { term: 'Link Equity', letter: 'L', def: 'The ranking value passed from one page to another through links. Also called "link juice". Internal links distribute equity across your site. External links from authoritative domains inject new equity.' },
  { term: 'Local Pack', letter: 'L', def: 'The three-business map listing Google shows for local searches. When someone searches "solicitor Birmingham", the Local Pack appears above organic results. Ranking here requires an optimised Google Business Profile and strong local signals.' },
  { term: 'Local SEO', letter: 'L', def: 'SEO focused on improving visibility for geographically relevant searches. For Birmingham businesses, that means Google Business Profile optimisation, local citations, location-specific content, and review management. <a href="/services/">Our services cover this</a>.' },
  { term: 'Long-Tail Keyword', letter: 'L', def: 'A longer, more specific search phrase like "best Italian restaurant Jewellery Quarter Birmingham" rather than "restaurant Birmingham". Lower search volume but higher conversion intent. Easier to rank for.' },
  { term: 'llms.txt', letter: 'L', def: 'A proposed standard file (like robots.txt) that gives AI language models a machine-readable summary of your website. Placing it at your domain root helps ChatGPT, Claude, and other AI systems understand your business. Most competitors have not adopted it yet.' },

  { term: 'Meta Description', letter: 'M', def: 'The HTML snippet (under 160 characters) that describes a page\'s content. Not a direct ranking factor, but controls what appears in search results. A compelling meta description lifts click-through rate.' },
  { term: 'Meta Title', letter: 'M', def: 'See Title Tag. The terms are interchangeable. The HTML title element that appears as the clickable headline in search results.' },
  { term: 'Mobile-First Indexing', letter: 'M', def: 'Google\'s approach of using the mobile version of your site for indexing and ranking. If your mobile site is missing content, has broken layouts, or loads slowly, that is what Google judges you on, not the desktop version.' },
  { term: 'Manual Action', letter: 'M', def: 'A penalty applied by a human reviewer at Google for violating webmaster guidelines. Reported in Google Search Console. Requires fixing the issue and submitting a reconsideration request. Recovery can take weeks to months.' },

  { term: 'NAP Consistency', letter: 'N', def: 'Name, Address, Phone number, kept identical across every online listing, directory, and citation. Inconsistent NAP confuses search engines and weakens local rankings. Check yours on Google, Yell, Bing Places, and industry directories.' },
  { term: 'Nofollow', letter: 'N', def: 'A link attribute (rel="nofollow") that tells search engines not to pass ranking value through the link. Used for sponsored links, user-generated content, and untrusted sources. Search engines may still crawl the linked page.' },
  { term: 'Noindex', letter: 'N', def: 'A meta tag or HTTP header that tells search engines not to include a page in their index. Used for thin pages, duplicate content, and admin pages you do not want appearing in search results.' },
  { term: 'Natural Language Processing', letter: 'N', def: 'The AI technology search engines use to understand the meaning behind search queries and web content. Google\'s BERT and MUM models use NLP to interpret context, intent, and relationships between words, not just keywords.' },

  { term: 'Organic Traffic', letter: 'O', def: 'Visitors who arrive at your website through unpaid search results. The primary goal of SEO. Organic traffic compounds over time, unlike paid ads, the clicks do not stop when the budget runs out.' },
  { term: 'Off-Page SEO', letter: 'O', def: 'SEO activities that happen outside your website: backlink building, brand mentions, social signals, and third-party citations. Off-page signals tell search engines what the rest of the internet thinks about your site.' },
  { term: 'On-Page SEO', letter: 'O', def: 'Optimisations made directly on your web pages: title tags, header structure, content quality, internal links, image alt text, and URL structure. The foundation of any SEO strategy. <a href="/seo-audit-birmingham/">Our audits cover this</a>.' },
  { term: 'Orphan Page', letter: 'O', def: 'A page on your website that has no internal links pointing to it. Search engines struggle to discover orphan pages, and they receive no link equity from the rest of your site. Usually a sign of poor site architecture.' },

  { term: 'Page Speed', letter: 'P', def: 'How quickly your web page loads and becomes interactive. Measured by Core Web Vitals (LCP, INP, CLS) and tools like PageSpeed Insights. Slow pages lose visitors and rankings. <a href="/technical-seo-birmingham/">Technical SEO fixes speed issues</a>.' },
  { term: 'PageRank', letter: 'P', def: 'Google\'s original algorithm for measuring page importance based on backlinks. The public toolbar score was retired in 2016, but the underlying concept still drives how Google evaluates link equity. Links from high-PageRank pages carry more weight.' },
  { term: 'PPC (Pay-Per-Click)', letter: 'P', def: 'Paid advertising where you pay each time someone clicks your ad. Google Ads is the most common PPC platform. SEO and PPC complement each other, PPC gives immediate visibility while SEO builds sustainable organic traffic.' },
  { term: 'Position Zero', letter: 'P', def: 'The featured snippet or answer box that appears above the first organic result. Earning position zero means your content was selected as the best direct answer. Requires structured, concise content that directly addresses the query.' },

  { term: 'Query', letter: 'Q', def: 'The word or phrase a user types into a search engine. Understanding query intent, whether someone wants information, a specific website, or to buy something, is fundamental to creating content that ranks.' },
  { term: 'Quality Score', letter: 'Q', def: 'Primarily a Google Ads metric rating ad relevance, landing page experience, and expected CTR. In broader SEO context, it reflects how well your page satisfies user intent. Higher quality means lower costs in paid search and better rankings in organic.' },

  { term: 'Ranking Factor', letter: 'R', def: 'Any signal a search engine uses to determine where a page appears in results. Google uses hundreds of ranking factors including content relevance, backlinks, page speed, mobile experience, and user engagement. No single factor guarantees rankings.' },
  { term: 'Redirect (301/302)', letter: 'R', def: 'A server instruction that sends users and search engines from one URL to another. A 301 is permanent (passes link equity). A 302 is temporary (does not). Use 301s when pages move permanently. Broken redirects waste crawl budget.' },
  { term: 'Robots.txt', letter: 'R', def: 'A text file at your domain root that tells search engine crawlers which pages they can and cannot access. Misconfigured robots.txt can accidentally block your entire site from being indexed. <a href="/technical-seo-birmingham/">We audit this</a>.' },
  { term: 'Rich Snippet', letter: 'R', def: 'An enhanced search result that displays additional information, star ratings, prices, FAQ dropdowns, event dates, pulled from structured data on your page. Rich snippets increase CTR by making your listing stand out.' },
  { term: 'Rendering', letter: 'R', def: 'The process of a browser or search engine bot executing JavaScript and CSS to display a page. If Googlebot cannot render your content, it cannot index it. Server-side rendering avoids this problem entirely.' },

  { term: 'Schema Markup', letter: 'S', def: 'Structured data vocabulary (schema.org) that helps search engines understand page content. Tells Google your page contains a business, product, FAQ, or event, not just text. Implemented via JSON-LD, microdata, or RDFa.' },
  { term: 'SERP', letter: 'S', def: 'Search Engine Results Page. The page you see after submitting a search query. Modern SERPs include organic results, ads, featured snippets, Local Pack, Knowledge Panels, People Also Ask, and AI Overviews.' },
  { term: 'Sitemap', letter: 'S', def: 'An XML file listing all the pages on your site that you want search engines to index. Submit it through Google Search Console and Bing Webmaster Tools. Helps crawlers discover pages, especially on large or new sites.' },
  { term: 'Site Architecture', letter: 'S', def: 'The way your website\'s pages are organised and linked together. A flat, logical architecture ensures every important page is within three clicks of the homepage. Poor architecture buries content and wastes crawl budget.' },
  { term: 'Structured Data', letter: 'S', def: 'Code added to your pages that explicitly tells search engines what your content means. Product prices, business hours, review ratings, FAQ answers, all communicated in a format machines parse directly. Powers rich snippets and AI citations.' },
  { term: 'Search Intent', letter: 'S', def: 'The reason behind a search query. Informational (learn something), navigational (find a specific site), commercial (compare options), or transactional (buy something). Matching content to intent is the single most important SEO principle.' },
  { term: 'Semantic SEO', letter: 'S', def: 'An approach that optimises for meaning and context rather than individual keywords. Covers related entities, topic depth, and content architecture that satisfies the full scope of a searcher\'s intent. Goes beyond keywords into topical authority.' },

  { term: 'Technical SEO', letter: 'T', def: 'The practice of optimising website infrastructure for search engine crawling, indexing, and rendering. Covers site speed, mobile experience, structured data, security, and crawl efficiency. The foundation everything else sits on. <a href="/technical-seo-birmingham/">Our technical SEO service</a>.' },
  { term: 'Title Tag', letter: 'T', def: 'The HTML title element that appears as the clickable blue headline in search results. Keep it under 60 characters, include your primary keyword, and make it compelling. The single most important on-page SEO element.' },
  { term: 'Topical Authority', letter: 'T', def: 'The depth and breadth of content a website has on a specific subject. A Birmingham accountancy firm that publishes comprehensive guides on tax, bookkeeping, and payroll builds topical authority that a single "services" page never can.' },
  { term: 'TF-IDF', letter: 'T', def: 'Term Frequency-Inverse Document Frequency. A statistical measure of how important a word is within a document relative to a collection of documents. Used in SEO tools to identify terms your content should include to match top-ranking pages.' },

  { term: 'URL Structure', letter: 'U', def: 'The format and hierarchy of your page addresses. Clean URLs like /services/technical-seo/ are better than /page?id=437&cat=2. Short, descriptive, keyword-relevant URLs help users and search engines understand page content.' },
  { term: 'User Experience (UX)', letter: 'U', def: 'How easy and pleasant your website is to use. Google measures UX signals through Core Web Vitals, mobile usability, and engagement metrics. A confusing layout or slow page drives visitors to competitors.' },
  { term: 'User Intent', letter: 'U', def: 'See Search Intent. What the searcher actually wants when they type a query. Understanding user intent determines whether your page should educate, compare, or sell.' },

  { term: 'Voice Search', letter: 'V', def: 'Searching by speaking to a device, Siri, Alexa, Google Assistant. Voice queries are longer and more conversational than typed searches. Optimising for voice means answering specific questions in natural, concise language.' },
  { term: 'Visibility Score', letter: 'V', def: 'A metric from SEO tools (Sistrix, Semrush) estimating how visible your domain is in search results across all tracked keywords. A rising visibility score means your SEO is working. A falling one means something needs attention.' },

  { term: 'White Hat SEO', letter: 'W', def: 'SEO practices that follow search engine guidelines. Quality content, earned backlinks, technical excellence, and genuine user value. Takes longer than shortcuts but builds sustainable rankings that survive algorithm updates.' },
  { term: 'WordPress SEO', letter: 'W', def: 'SEO specific to WordPress websites. Covers plugin configuration (Yoast, RankMath), theme performance, database optimisation, security hardening, and managing the duplicate content problems WordPress creates by default.' },

  { term: 'XML Sitemap', letter: 'X', def: 'A machine-readable file listing all indexable URLs on your site with metadata like last modification date and priority. Submit to Google Search Console and Bing Webmaster Tools. Essential for large sites and new domains.' },

  { term: 'YMYL (Your Money Your Life)', letter: 'Y', def: 'Google\'s classification for pages that could impact a person\'s health, finances, safety, or wellbeing. YMYL pages face stricter quality evaluation. Medical practices, financial advisers, and legal firms in Birmingham must demonstrate strong E-E-A-T.' },

  { term: 'Zero-Click Search', letter: 'Z', def: 'A search where the user gets their answer directly on the results page without clicking through to any website. Featured snippets, Knowledge Panels, and AI Overviews drive zero-click searches. Optimising for these means earning brand visibility even without the click.' },
];

const letters = [...new Set(terms.map(t => t.letter))].sort();
const grouped = letters.map(l => ({ letter: l, items: terms.filter(t => t.letter === l) }));

const definedTermSetSchema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'SEO Glossary',
  description: 'Comprehensive glossary of SEO terms explained for Birmingham businesses.',
  url: 'https://seo-birmingham.uk/seo-glossary/',
  publisher: {
    '@type': 'Organization',
    name: 'SEO Birmingham',
    url: 'https://seo-birmingham.uk',
  },
  hasDefinedTerm: terms.slice(0, 10).map(t => ({
    '@type': 'DefinedTerm',
    name: t.term,
    description: t.def.replace(/<[^>]*>/g, ''),
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://seo-birmingham.uk/' },
    { '@type': 'ListItem', position: 2, name: 'SEO Glossary', item: 'https://seo-birmingham.uk/seo-glossary/' },
  ],
};
---

<Base
  title="SEO Glossary: 80+ Terms Explained | SEO Birmingham"
  description="Every SEO term explained in plain language. From algorithms to zero-click searches, this glossary covers what Birmingham businesses need to know."
  schema={[definedTermSetSchema, breadcrumbSchema]}
>

  <!-- Hero -->
  <section class="relative bg-brand text-white overflow-hidden">
    <div class="absolute top-[-20%] left-[-10%] w-[500px] h-[500px] rounded-full opacity-[0.07] blur-[100px]"
         style="background: radial-gradient(circle, #F59E0B, transparent 70%); animation: aurora-1 8s ease-in-out infinite;"></div>
    <div class="absolute bottom-[-15%] right-[-5%] w-[400px] h-[400px] rounded-full opacity-[0.05] blur-[80px]"
         style="background: radial-gradient(circle, #FBBF24, transparent 70%); animation: aurora-2 12s ease-in-out infinite;"></div>
    <div class="absolute inset-0 opacity-[0.03]"
         style="background-image: radial-gradient(circle, rgba(245,158,11,0.5) 1px, transparent 1px); background-size: 32px 32px;"></div>

    <div class="relative max-w-6xl mx-auto px-4 py-24 md:py-32 w-full">
      <p class="text-accent font-bold text-sm uppercase tracking-widest mb-4 fade-up" style="font-family: var(--font-heading);">SEO Birmingham</p>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-[1.05] mb-6 fade-up" style="--i:1; font-family: var(--font-heading); letter-spacing: -0.04em;">
        SEO Glossary<br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-accent-light">Every Term Explained</span>
      </h1>
      <p class="text-zinc-400 text-lg md:text-xl max-w-2xl mb-8 fade-up stagger-child" style="--i:2;">
        {terms.length} SEO terms defined in plain language. No jargon walls. No filler. A practical reference for Birmingham businesses navigating search, from algorithm updates to zero-click searches.
      </p>
      <div class="flex flex-wrap gap-4 fade-up stagger-child" style="--i:3;">
        <a href="/free-seo-audit-birmingham/" class="btn-shimmer">Free SEO Audit</a>
        <a href="/services/" class="inline-block border-2 border-zinc-600 text-white px-6 py-3 font-bold text-sm uppercase tracking-wider hover:border-accent hover:text-accent transition-colors duration-200" style="font-family: var(--font-heading);">Our Services</a>
      </div>
    </div>
  </section>

  <!-- Alphabet Nav -->
  <nav class="sticky top-0 z-40 bg-brand/95 backdrop-blur-md border-b border-zinc-800" aria-label="Alphabet navigation">
    <div class="max-w-4xl mx-auto px-4 py-3 overflow-x-auto scrollbar-hide">
      <div class="flex gap-2 min-w-max justify-center">
        {letters.map(l => (
          <a href={`#letter-${l}`}
             class="inline-block px-3 py-1.5 text-sm font-bold rounded-full border border-zinc-700 text-zinc-400 hover:text-accent hover:border-accent transition-colors duration-200"
             style="font-family: var(--font-heading);">
            {l}
          </a>
